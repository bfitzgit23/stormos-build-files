# ── Colors ───────────────────────────────────────────────────────────────────
NAVY   = "#0a192f"
BLUE   = "#19A9FF"
LIGHT  = "#E8F2FF"
DARK   = "#020c1b"
GLASS  = "rgba(2, 12, 27, 0.85)"
CORAL  = "#ff6b6b"
GREEN  = "#4ADE80"

HOME = Path.home()
AUTOSTART_FILE   = HOME / ".config/autostart/julinux-welcome.desktop"
AUTOSTART_MARKER = HOME / ".julinux-welcome-disabled"
LIVE_MARKERS     = ["/run/live", "/run/archiso", "/run/live/medium"]
JULINUX_MARKER   = Path("/etc/julinux-release")

# Packages installed by the JULinux post-install flow
JULINUX_PACKAGES = [
    "fastfetch", "switcheroo-control",
    "nvidia-detect", "broadcom-sta-dkms", "blueman", "bluez",
    "pipewire", "pipewire-pulse", "wireplumber",
    "arc-theme", "papirus-icon-theme", "plymouth",
    "xfce4-terminal",
]


# ── Helpers ──────────────────────────────────────────────────────────────────
def is_live():
    return any(Path(m).exists() for m in LIVE_MARKERS)

def is_installed():
    return JULINUX_MARKER.exists()

def find_terminal():
    for name in ["xfce4-terminal", "gnome-terminal", "xterm"]:
        path = shutil.which(name)
        if path:
            return path, name
    return None, None

def run_in_terminal(cmd, title="JULinux"):
    """Run a shell command in the user's terminal."""
    path, name = find_terminal()
    if not path:
        QMessageBox.critical(None, "Error", "No terminal emulator found.")
        return
    if name == "xfce4-terminal":
        subprocess.Popen([path, "--disable-server", "--title", title,
                          "--command", f'bash -c "{cmd}; echo; echo Press Enter to close...; read"'],
                         start_new_session=True)
    else:
        subprocess.Popen([path, "-e", f'bash -c "{cmd}; echo Press Enter; read"'],
                         start_new_session=True)


# ── Background worker for apt operations ─────────────────────────────────────
class AptWorker(QThread):
    progress = pyqtSignal(str)
    finished = pyqtSignal(bool, str)   # (success, message)

    def __init__(self, action, packages=None):
        super().__init__()
        self.action = action        # "install", "remove", "update", "upgrade"
        self.packages = packages or []

    def run(self):
        try:
            if self.action == "update":
                self.progress.emit("Running: sudo apt update")
                r = subprocess.run(["sudo", "apt", "update", "-y"],
                                   capture_output=True, text=True, timeout=300)
                self.finished.emit(r.returncode == 0,
                                   r.stdout[-2000:] if r.stdout else r.stderr[-2000:])
            elif self.action == "upgrade":
                self.progress.emit("Running: sudo apt upgrade")
                r = subprocess.run(["sudo", "apt", "upgrade", "-y"],
                                   capture_output=True, text=True, timeout=600)
                self.finished.emit(r.returncode == 0,
                                   r.stdout[-2000:] if r.stdout else r.stderr[-2000:])
            elif self.action == "install":
                pkgs = " ".join(self.packages)
                self.progress.emit(f"Installing: {pkgs}")
                r = subprocess.run(["sudo", "apt", "install", "-y"] + self.packages,
                                   capture_output=True, text=True, timeout=600)
                self.finished.emit(r.returncode == 0,
                                   r.stdout[-2000:] if r.stdout else r.stderr[-2000:])
            elif self.action == "remove":
                pkgs = " ".join(self.packages)
                self.progress.emit(f"Removing: {pkgs}")
                r = subprocess.run(["sudo", "apt", "remove", "-y"] + self.packages,
                                   capture_output=True, text=True, timeout=300)
                self.finished.emit(r.returncode == 0,
                                   r.stdout[-2000:] if r.stdout else r.stderr[-2000:])
        except Exception as e:
            self.finished.emit(False, str(e))


# ── Progress dialog ──────────────────────────────────────────────────────────
class ProgressDialog(QDialog):
    def __init__(self, title, parent=None):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.setMinimumSize(500, 350)
        self.setModal(True)

        layout = QVBoxLayout(self)
        layout.setSpacing(12)

        self.status = QLabel("Starting...")
        self.status.setStyleSheet(f"font-size: 14px; font-weight: bold; color: {BLUE};")
        layout.addWidget(self.status)

        self.output = QTextEdit()
        self.output.setReadOnly(True)
        self.output.setStyleSheet(f"""
            background: {DARK}; color: {LIGHT};
            border: 1px solid rgba(100, 255, 218, 0.2); border-radius: 8px;
            font-family: monospace; font-size: 12px;
        """)
        layout.addWidget(self.output)

        self.progress = QProgressBar()
        self.progress.setRange(0, 0)  # indeterminate
        self.progress.setStyleSheet(f"""
            QProgressBar {{ background: {DARK}; border: 1px solid {BLUE}; border-radius: 6px; height: 8px; }}
            QProgressBar::chunk {{ background: {BLUE}; border-radius: 6px; }}
        """)
        layout.addWidget(self.progress)

        btn_layout = QHBoxLayout()
        self.close_btn = QPushButton("Close")
        self.close_btn.setEnabled(False)
        self.close_btn.clicked.connect(self.accept)
        btn_layout.addStretch()
        btn_layout.addWidget(self.close_btn)
        layout.addLayout(btn_layout)

    def set_status(self, text):
        self.status.setText(text)

    def append_output(self, text):
        self.output.append(text)

    def done(self, success, message):
        self.progress.setRange(0, 1)
        self.progress.setValue(1 if success else 0)
        self.append_output(message)
        self.close_btn.setEnabled(True)
        if success:
            self.status.setText("✓ Completed successfully")
            self.status.setStyleSheet(f"font-size: 14px; font-weight: bold; color: {GREEN};")
        else:
            self.status.setText("✗ Failed — see output above")
            self.status.setStyleSheet(f"font-size: 14px; font-weight: bold; color: {CORAL};")


# ── Uninstall confirmation dialog ────────────────────────────────────────────
class UninstallDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Uninstall JULinux Components")
        self.setMinimumSize(500, 420)

        layout = QVBoxLayout(self)
        layout.setSpacing(12)

        title = QLabel("Remove JULinux components from your system")
        title.setStyleSheet(f"font-size: 16px; font-weight: bold; color: {BLUE};")
        layout.addWidget(title)

        desc = QLabel("Select which components to remove. Base Debian system will not be affected.")
        desc.setStyleSheet(f"color: {LIGHT}; font-size: 12px;")
        desc.setWordWrap(True)
        layout.addWidget(desc)

        self.chk_welcome    = QCheckBox("Welcome app (julinux-welcome)")
        self.chk_welcome.setChecked(True)
        self.chk_switcheroo = QCheckBox("GPU switcher applet (switcheroo-applet)")
        self.chk_switcheroo.setChecked(True)
        self.chk_autostart  = QCheckBox("Autostart entry")
        self.chk_autostart.setChecked(True)
        self.chk_packages   = QCheckBox("JULinux extra packages (fastfetch, broadcom, etc.)")
        self.chk_packages.setChecked(False)

        for chk in [self.chk_welcome, self.chk_switcheroo, self.chk_autostart,
                     self.chk_packages]:
            chk.setStyleSheet(f"color: {LIGHT}; font-size: 13px; padding: 4px 0;")
            layout.addWidget(chk)

        layout.addStretch()

        buttons = QDialogButtonBox(QDialogButtonBox.Ok | QDialogButtonBox.Cancel)
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        buttons.button(QDialogButtonBox.Ok).setText("Remove Selected")
        buttons.button(QDialogButtonBox.Ok).setStyleSheet(
            f"background: {CORAL}; color: {DARK}; padding: 8px 20px; border-radius: 8px; font-weight: bold;")
        buttons.button(QDialogButtonBox.Cancel).setStyleSheet(
            f"background: rgba(100,255,218,0.1); color: {LIGHT}; padding: 8px 20px; border-radius: 8px;")
        layout.addWidget(buttons)


