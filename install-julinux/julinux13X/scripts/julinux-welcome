    # ── Helpers ──────────────────────────────────────────────────────────────
    def glass_card(self, title):
        card = QWidget()
        card.setStyleSheet(f"""
            QWidget {{
                background-color: {GLASS};
                border: 1px solid rgba(100, 255, 218, 0.2);
                border-radius: 16px;
            }}
        """)
        layout = QVBoxLayout(card)
        layout.setContentsMargins(16, 12, 16, 16)
        layout.setSpacing(10)
        lbl = QLabel(title)
        lbl.setStyleSheet(f"color: {BLUE}; font-weight: bold; font-size: 14px; background: transparent; border: none;")
        layout.addWidget(lbl)
        return card

    def _scroll_wrap(self, widget):
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setWidget(widget)
        scroll.setFrameShape(QScrollArea.NoFrame)
        scroll.setStyleSheet("QScrollArea { background: transparent; border: none; }")
        return scroll

    # ── Actions ──────────────────────────────────────────────────────────────
    def launch_calamares(self):
        if not shutil.which("calamares"):
            QMessageBox.warning(self, "Not Found", "Calamares is not installed.\nUse the Install tab to set up JULinux extras.")
            return
        run_in_terminal("sudo calamares", "Calamares Installer")

    def install_all_extras(self):
        self._run_apt("install", JULINUX_PACKAGES, "Install All JULinux Extras")

    def install_packages(self, pkgs, label):
        self._run_apt("install", pkgs, f"Install {label}")

    def run_apt_update(self):
        self._run_apt("update", [], "Update Package Lists")

    def run_apt_upgrade(self):
        self._run_apt("upgrade", [], "Full System Upgrade")

    def detect_hardware(self):
        run_in_terminal(
            "echo '=== CPU ===' && lscpu | head -6 && echo && "
            "echo '=== GPU ===' && lspci | grep -i 'vga\\|3d\\|display' && echo && "
            "echo '=== RAM ===' && free -h | head -2 && echo && "
            "echo '=== Disk ===' && lsblk -d -o NAME,SIZE,MODEL && echo && "
            "echo '=== Network ===' && ip link show | grep -E '^[0-9]' && echo && "
            "echo '=== Bluetooth ===' && (bluetoothctl show 2>/dev/null || echo 'Not available')",
            "Hardware Detection"
        )

    def _run_apt(self, action, packages, title):
        dlg = ProgressDialog(title, self)
        worker = AptWorker(action, packages)
        worker.progress.connect(dlg.set_status)
        worker.finished.connect(dlg.done)
        worker.start()
        dlg.exec()

    def enable_autostart(self):
        AUTOSTART_FILE.parent.mkdir(parents=True, exist_ok=True)
        AUTOSTART_FILE.write_text(
            "[Desktop Entry]\n"
            "Type=Application\n"
            "Name=JULinux Welcome\n"
            "Exec=julinux-welcome\n"
            "Icon=julinux\n"
            "Terminal=false\n"
            "X-GNOME-Autostart-enabled=true\n"
            "Categories=System;\n"
        )
        if AUTOSTART_MARKER.exists():
            AUTOSTART_MARKER.unlink()
        QMessageBox.information(self, "Autostart", "Welcome app will now start on login.")

    def disable_autostart(self):
        if AUTOSTART_FILE.exists():
            AUTOSTART_FILE.unlink()
        AUTOSTART_MARKER.touch()
        QMessageBox.information(self, "Autostart", "Welcome app will no longer start on login.")

    def show_uninstall_dialog(self):
        dlg = UninstallDialog(self)
        if dlg.exec() != QDialog.Accepted:
            return

        to_remove = []
        if dlg.chk_welcome.isChecked():
            # Remove the welcome app script + desktop file
            to_remove.append("_welcome")
        if dlg.chk_switcheroo.isChecked():
            to_remove.append("_switcheroo")
        if dlg.chk_autostart.isChecked():
            self.disable_autostart()
        if dlg.chk_packages.isChecked():
            to_remove.extend(["fastfetch", "switcheroo-control", "nvidia-detect",
                              "broadcom-sta-dkms", "pipewire", "pipewire-pulse", "wireplumber"])

        # Separate apt packages from file removals
        apt_pkgs = [p for p in to_remove if not p.startswith("_")]

        if apt_pkgs:
            self._run_apt("remove", apt_pkgs, "Remove JULinux Components")

        # Remove files
        removed = []
        if "_welcome" in to_remove:
            for p in [Path("/usr/local/bin/julinux-welcome"),
                      AUTOSTART_FILE]:
                if p.exists():
                    p.unlink()
                    removed.append(str(p))
        if "_switcheroo" in to_remove:
            for p in [Path("/usr/local/bin/switcheroo-applet")]:
                if p.exists():
                    p.unlink()
                    removed.append(str(p))

        if removed:
            QMessageBox.information(self, "Removed", "Removed files:\n" + "\n".join(removed))
        elif not apt_pkgs:
            QMessageBox.information(self, "Nothing to do", "No components were selected for removal.")

