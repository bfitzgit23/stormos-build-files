# Maintainer: StormOS Project <stormos@example.org>
pkgname=stormos-react-desktop
pkgver=0.3.0
pkgrel=1
pkgdesc='StormOS React-based desktop shell (Electron + openbox + LightDM)'
arch=('x86_64')
url='https://github.com/bfitzgit23/stormos-build-files'
license=('MIT')
depends=(
    'electron'
    'openbox'
    'python'
    'python-requests'
    'foot'
    'thunar'
    'gvfs'
    'gvfs-mtp'
    'gvfs-smb'
    'gvfs-gphoto2'
    'gvfs-nfs'
    'gvfs-dnssd'
    'udisks2'
    'thunar-volman'
    'firefox'
    'libreoffice-fresh'
    'xdg-utils'
    'polkit-gnome'
    'networkmanager'
    'bluez'
    'bluez-utils'
    'pipewire'
    'wireplumber'
    'pavucontrol'
    'blueman'
    'lightdm'
    'lightdm-slick-greeter'
    'steam'
    'switcheroo-control'
    'playerctl'
)
makedepends=(
    'npm'
    'nodejs'
)
optdepends=(
    'fastfetch: system information display'
    'qutebrowser: lightweight browser'
    'newsbeuter: RSS reader'
    'playerctl: MPRIS media controls (installed as dependency)'
)
provides=('stormos-desktop')
conflicts=('stormos-desktop-shell')
backup=(
    'etc/fastfetch/config.jsonc'
    'etc/lightdm/slick-greeter.conf'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname"

    # If the source tarball ships a prebuilt dist/, skip npm entirely
    if [ -f dist/index.html ]; then
        echo 'Prebuilt dist/ present; skipping npm install.'
        return 0
    fi

    echo 'No prebuilt dist/; installing npm dependencies...'
    npm install --no-audit --no-fund --ignore-scripts
}

build() {
    cd "$srcdir/$pkgname"

    # Skip build if dist/ already exists (prebuilt tarball)
    if [ -f dist/index.html ]; then
        echo 'Prebuilt dist/ present; skipping npm build.'
        return 0
    fi

    echo 'Building React frontend...'
    npm run build
}

package() {
    cd "$srcdir/$pkgname"

    # --- Sanity check ---
    if [ ! -f dist/index.html ]; then
        error "dist/ is missing. Rebuild the tarball with ./build-package.sh --src-only"
        error "or install npm/nodejs and rerun makepkg."
        return 1
    fi

    # === Core shell ===
    install -dm755 "$pkgdir/usr/share/stormos-shell"
    cp -a dist "$pkgdir/usr/share/stormos-shell/"
    cp -a src "$pkgdir/usr/share/stormos-shell/"
    cp -a native "$pkgdir/usr/share/stormos-shell/"
    cp -a bin "$pkgdir/usr/share/stormos-shell/"
    cp -a session "$pkgdir/usr/share/stormos-shell/"
    install -m644 main.js preload.js vite.config.js package.json index.html \
        "$pkgdir/usr/share/stormos-shell/"

    # === Electron entry point ===
    install -m644 main.js "$pkgdir/usr/share/stormos-shell/main.js"
    install -m644 preload.js "$pkgdir/usr/share/stormos-shell/preload.js"

    # === Binaries ===
    install -dm755 "$pkgdir/usr/bin"

    # Main launcher
    cat > "$pkgdir/usr/bin/stormos-desktop" << 'LAUNCHER'
#!/usr/bin/env bash
# StormOS Desktop launcher — called by LightDM or .xinitrc
export STORMOS_DESKTOP_DIR="/usr/share/stormos-shell"
exec bash "/usr/share/stormos-shell/bin/stormos-desktop" "$@"
LAUNCHER
    chmod 755 "$pkgdir/usr/bin/stormos-desktop"

    # Python bridge
    install -m755 native/stormos-bridge.py "$pkgdir/usr/bin/stormos-bridge"

    # === Session files (LightDM) ===
    install -dm755 "$pkgdir/usr/share/xsessions"
    cat > "$pkgdir/usr/share/xsessions/stormos-desktop.desktop" << 'XS'
[Desktop Entry]
Name=StormOS Desktop
Comment=StormOS React desktop shell (Electron + openbox)
Exec=/usr/local/bin/stormos-desktop
TryExec=/usr/local/bin/stormos-desktop
Type=Application
DesktopNames=StormOS
XS

    # === LightDM slick-greeter config ===
    install -dm755 "$pkgdir/etc/lightdm"
    install -m644 session/lightdm/slick-greeter.conf \
        "$pkgdir/etc/lightdm/slick-greeter.conf"

    # === Fastfetch config ===
    install -dm755 "$pkgdir/etc/fastfetch"
    if [ -f "$srcdir/$pkgname/etc/fastfetch/config.jsonc" ]; then
        install -m644 "$srcdir/$pkgname/etc/fastfetch/config.jsonc" \
            "$pkgdir/etc/fastfetch/config.jsonc"
    fi

    # === Wallpaper ===
    install -dm755 "$pkgdir/usr/share/backgrounds"
    if [ -f "$srcdir/$pkgname/session/stormos-wallpaper.png" ]; then
        install -m644 "$srcdir/$pkgname/session/stormos-wallpaper.png" \
            "$pkgdir/usr/share/backgrounds/stormos-wallpaper.png"
    elif [ -f public/stormos-wallpaper.svg ]; then
        install -m644 public/stormos-wallpaper.svg \
            "$pkgdir/usr/share/backgrounds/stormos-wallpaper.svg"
    fi

    # === Logo ===
    install -dm755 "$pkgdir/usr/share/pixmaps"
    if [ -f "$srcdir/$pkgname/session/stormos-logo.png" ]; then
        install -m644 "$srcdir/$pkgname/session/stormos-logo.png" \
            "$pkgdir/usr/share/pixmaps/stormos-logo.png"
    fi

    # === GTK theme ===
    if [ -d "$srcdir/$pkgname/themes/StormOS-GTK" ]; then
        cp -a "$srcdir/$pkgname/themes/StormOS-GTK" "$pkgdir/usr/share/themes/"
    fi

    # === Icon theme ===
    if [ -d "$srcdir/$pkgname/themes/StormOS-icons" ]; then
        cp -a "$srcdir/$pkgname/themes/StormOS-icons" "$pkgdir/usr/share/icons/"
    fi

    # === Foot terminal config ===
    if [ -f config/foot/foot.ini ]; then
        install -dm755 "$pkgdir/usr/share/foot"
        install -m644 config/foot/foot.ini "$pkgdir/usr/share/foot/foot.ini"
    fi

    # === Install the standalone installer (optional manual use) ===
    install -m755 install-stormos-desktop.sh \
        "$pkgdir/usr/share/stormos-shell/install-stormos-desktop.sh"

    # === Desktop entries ===
    install -dm755 "$pkgdir/usr/share/applications"
    if [ -f "$srcdir/$pkgname/usr/share/applications/stormos-settings.desktop" ]; then
        install -m644 "$srcdir/$pkgname/usr/share/applications/stormos-settings.desktop" \
            "$pkgdir/usr/share/applications/"
    fi
}
