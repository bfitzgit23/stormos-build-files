#!/usr/bin/env bash
#
# stormd-compiz-autostart — session autostart wrapper for Compiz.
#
# Runs at login (via stormos-compiz.desktop). Only launches Compiz when the
# saved WM mode says so (~/.config/stormd/wm-mode = "compiz", written by
# stormd-compiz-toggle). Otherwise exits silently and xfwm4 stays in charge.
#
set -u

MODE_FILE="$HOME/.config/stormd/wm-mode"
STORM_THEME="StormD"

# No saved mode, or mode is xfwm4 -> nothing to do
[ -f "$MODE_FILE" ] || exit 0
[ "$(cat "$MODE_FILE" 2>/dev/null || echo xfwm4)" = "compiz" ] || exit 0

# Compiz must be installed
command -v compiz >/dev/null 2>&1 || exit 0

# Wait (up to 10s) for the XFCE session and xfwm4 to be fully up
for i in $(seq 1 20); do
    pgrep -x xfwm4 >/dev/null 2>&1 && break
    sleep 0.5
done
sleep 1

# Apply the StormOS profile (wobbly + cube) before taking over
python3 /usr/local/bin/stormd-compiz-setup.py >/dev/null 2>&1 || true

# Set the metacity theme GWD will render (GSettings + gconf for 0.8)
gsettings set org.gnome.desktop.wm.preferences theme "$STORM_THEME" 2>/dev/null || true
gsettings set org.gnome.metacity.theme name "$STORM_THEME" 2>/dev/null || true
gconftool-2 -s /apps/metacity/general/theme -t string "$STORM_THEME" 2>/dev/null || true

# Replace xfwm4 with Compiz
killall xfwm4 2>/dev/null || true
sleep 0.5
compiz --replace ccp &
sleep 1

# Start the window decorator (compiz does not draw its own borders)
if command -v gtk-window-decorator >/dev/null 2>&1; then
    killall gtk-window-decorator 2>/dev/null || true
    nohup gtk-window-decorator --replace >/dev/null 2>&1 &
    sleep 1
    if ! pgrep -x gtk-window-decorator >/dev/null 2>&1; then
        nohup gtk-window-decorator --replace >/dev/null 2>&1 &
    fi
fi
