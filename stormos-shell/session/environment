# StormOS labwc environment
# Sourced by labwc at startup (before autostart). Keep this in sync with
# session/stormos-session which sets the same variables when launched from a
# display manager that does not source this file.

XDG_CURRENT_DESKTOP=StormOS
XDG_SESSION_DESKTOP=stormos
XDG_SESSION_TYPE=wayland
DESKTOP_SESSION=stormos
GDK_BACKEND=wayland,x11
GTK_USE_PORTAL=1
GTK_THEME=StormOS-GTK
GTK4_THEME=StormOS-GTK
XCURSOR_THEME=StormOS-icons
XCURSOR_SIZE=24
GIO_USE_VFS=gvfs
QT_QPA_PLATFORMTHEME=gnome
QT_WAYLAND_DISABLE_WINDOWDECORATION=1
