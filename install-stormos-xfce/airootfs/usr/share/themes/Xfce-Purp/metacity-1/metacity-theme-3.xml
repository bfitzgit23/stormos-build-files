    <maximized state="heading">
      <border color="#282e3c" style="plain" />
      <distance name="left" value="0" />
      <distance name="right" value="0" />
      <distance name="top" value="1" />
      <distance name="bottom" value="0" />
    </maximized>
    <unmaximized>
      <border color="#282e3c" style="plain" />
      <distance name="left" value="1" />
      <distance name="right" value="1" />
      <distance name="top" value="1" />
      <distance name="bottom" value="1" />
