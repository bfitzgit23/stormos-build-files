[Desktop Entry]
Name=StormOS Installer (CLI)
Comment=Command Line Installer For StormOS
Exec=alacritty --class 'alacritty-float,alacritty-float' --config-file /abif-master/alacritty.toml --title 'StormOS Installer (CLI)' -e sudo /abif-master/abif
Icon=stormos
Type=Application
Categories=System;SystemUtils;
Terminal=false
Hidden=false
NoDisplay=false
StartupNotify=false
X-GNOME-Autostart-enabled=false
X-KDE-autostart=false
