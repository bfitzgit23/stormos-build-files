[Desktop Entry]
Version=1.0
Type=Application
Name=StormOS Gallery
GenericName=Image Viewer
Comment=View and browse images
Exec=stormos-gallery %F
Icon=stormos-gallery
Terminal=false
Categories=Graphics;Viewer;RasterGraphics;2DGraphics;Photography;
MimeType=image/bmp;image/gif;image/jpeg;image/jpg;image/png;image/tiff;image/x-bmp;image/x-pcx;image/x-tga;image/x-portable-pixmap;image/webp;image/svg+xml;
Keywords=pictures;images;photos;gallery;viewer;
StartupNotify=true
X-StormOS-App=true
