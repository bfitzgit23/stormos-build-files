#!/usr/bin/env bash
# StormOS startup hook for labwc.
#
# labwc runs this file after the compositor is fully initialised. This is the
# single source of truth for session startup: the display manager only execs
# labwc (via session/stormos-session), and everything else is started here so
# the StormOS shell loads *with* the compositor as one desktop.
#
# Each component is started independently so one failure cannot stop the rest.

set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/stormos"
mkdir -p "$STATE_DIR"

log_start() {
    name="$1"
    shift
    "$@" >>"$STATE_DIR/${name}.log" 2>&1 &
    echo $! >"$STATE_DIR/${name}.pid"
}

# ---------------------------------------------------------------------------
# Publish the session environment (labwc already imported its own environment
# file; this covers dbus-activated and systemd --user services).
# ---------------------------------------------------------------------------
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        DISPLAY WAYLAND_DISPLAY \
        XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION \
        GTK_THEME GTK4_THEME XCURSOR_THEME XCURSOR_SIZE XDG_DATA_DIRS \
        GIO_USE_VFS GTK_USE_PORTAL \
        >>"$STATE_DIR/environment.log" 2>&1 || true
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment \
        DISPLAY WAYLAND_DISPLAY \
        XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE DESKTOP_SESSION \
        GTK_THEME GTK4_THEME XCURSOR_THEME XCURSOR_SIZE XDG_DATA_DIRS \
        GIO_USE_VFS GTK_USE_PORTAL \
        >>"$STATE_DIR/environment.log" 2>&1 || true
fi

# ---------------------------------------------------------------------------
# Session services: removable/remote volumes and the polkit agent.
# ---------------------------------------------------------------------------
if command -v gvfsd >/dev/null 2>&1; then
    log_start gvfs gvfsd
fi
if command -v gvfs-udisks2-volume-monitor >/dev/null 2>&1; then
    log_start gvfs-udisks2 gvfs-udisks2-volume-monitor
fi
if command -v gvfs-metadata >/dev/null 2>&1; then
    log_start gvfs-metadata gvfs-metadata
fi

if [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    log_start polkit /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
elif command -v lxqt-policykit-agent >/dev/null 2>&1; then
    log_start polkit lxqt-policykit-agent
fi

# ---------------------------------------------------------------------------
# Shell backend: the local system bridge the React UI talks to.
# ---------------------------------------------------------------------------
if [ -x /usr/bin/stormos-bridge ]; then
    log_start bridge /usr/bin/stormos-bridge
else
    printf '%s\n' "Missing /usr/bin/stormos-bridge" >>"$STATE_DIR/bridge.log"
fi

# ---------------------------------------------------------------------------
# Wallpaper (system background). The shell draws its own themed backdrop on
# top, but this keeps the session presentable while the shell loads and if
# the shell host ever fails.
# ---------------------------------------------------------------------------
if command -v swaybg >/dev/null 2>&1 && [ -f /usr/share/backgrounds/stormos/stormos-wallpaper.svg ]; then
    log_start swaybg swaybg -i /usr/share/backgrounds/stormos/stormos-wallpaper.svg -m fill
fi

# ---------------------------------------------------------------------------
# XDG autostart: run the system-wide autostart entries (e.g. the Calamares
# installer on the live ISO). labwc has no built-in XDG autostart support,
# so dex runs the system autostart directory unfiltered.
if command -v dex >/dev/null 2>&1; then
    log_start dex dex -a /etc/xdg/autostart
fi

# ---------------------------------------------------------------------------
# The StormOS shell itself: panel, launcher, dock, desktop, system panel.
# GTK needs a moment for the Wayland connection; retry a few times so a slow
# first login does not leave the session without a shell.
# ---------------------------------------------------------------------------
if [ -x /usr/bin/stormos-shell-host ]; then
    (
        attempt=0
        while [ "$attempt" -lt 3 ]; do
            /usr/bin/stormos-shell-host >>"$STATE_DIR/shell-host.log" 2>&1
            code=$?
            attempt=$((attempt + 1))
            printf '%s shell-host exited with %s (attempt %s/3)\n' \
                "$(date '+%F %T')" "$code" "$attempt" >>"$STATE_DIR/shell-host.log"
            [ "$code" -eq 0 ] && break
            sleep 2
        done
    ) &
    echo $! >"$STATE_DIR/shell-host.pid"
else
    printf '%s\n' "Missing /usr/bin/stormos-shell-host" >"$STATE_DIR/shell-host.log"
fi
