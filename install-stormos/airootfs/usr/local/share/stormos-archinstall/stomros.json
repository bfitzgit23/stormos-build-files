            "type": "primary"
          }
        ]
      }
    ]
  },
  "hostname": "stomros",
  "kernels": [
    "linux"
  ],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US.UTF-8"
  },
  "network_config": {
    "type": "nm"
  },
  "ntp": true,
  "offline": false,
  "no_pkg_lookups": false,
  "pacman_config": {
    "color": false,
    "parallel_downloads": 5
  },
  "profile_config": {
    "profile": {
      "main": "Minimal"
    },
    "gfx_driver": null,
    "greeter": null
  },
  "packages": [
    "base",
    "linux",
    "linux-firmware",
    "linux-headers",
    "sudo",
    "networkmanager",
    "polkit",
    "polkit-gnome",
    "vim",
    "git",
    "curl",
    "wget",
    "htop",
    "btop",
    "unzip",
    "zip",
    "pipewire",
    "pipewire-pulse",
    "pipewire-alsa",
    "wireplumber",
    "brightnessctl",
    "power-profiles-daemon",
    "cpupower",
    "pciutils",
    "lightdm",
    "lightdm-slick-greeter",
    "xfce4",
    "xfce4-goodies",
    "xfce4-terminal",
    "xorg-server",
    "plymouth",
    "electron",
    "python",
    "firefox",
    "thunar",
    "gvfs",
    "gvfs-mtp",
    "gvfs-gphoto2",
    "file-roller",
    "xarchiver",
    "code",
    "noto-fonts",
    "noto-fonts-emoji",
    "noto-fonts-cjk",
    "ttf-jetbrains-mono",
    "ttf-firacode-nerd",
    "inter-font"
  ],
  "services": [
    "NetworkManager",
    "lightdm",
    "systemd-timesyncd"
  ],
  "silent": false,
  "swap": {
    "enabled": true,
    "algorithm": "zstd"
  },
  "timezone": "UTC",
  "custom_commands": [
    "systemctl set-default graphical.target\n",
    "if id -u storm >/dev/null 2>&1 && [ -f /etc/lightdm/lightdm.conf ]; then\n  groupadd -f autologin 2>/dev/null || true\n  usermod -aG autologin storm 2>/dev/null || true\n  sed -i 's/^#*autologin-user=.*/autologin-user=storm/' /etc/lightdm/lightdm.conf\nfi\n",
    "if [ -f /usr/share/xsessions/xfce.desktop ] && [ -f /etc/lightdm/lightdm.conf ]; then\n  sed -i 's/^#*user-session=.*/user-session=xfce/' /etc/lightdm/lightdm.conf\n  sed -i 's/^#*autologin-session=.*/autologin-session=xfce/' /etc/lightdm/lightdm.conf\nfi\n",
    "if [ -d /etc/lightdm ]; then\n  printf '[Greeter]\\nshow-clock=true\\nclock-format=%%H:%%M\\nfont-name=Inter 10\\n' > /etc/lightdm/slick-greeter.conf\nfi\n"
  ]
}
