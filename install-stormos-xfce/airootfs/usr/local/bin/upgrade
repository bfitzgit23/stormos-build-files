#!/usr/bin/env bash
#set -e
echo "##########################################"
echo "       System Settings Update Tool.       "
echo "##########################################"
sleep 5
read -r -p "New System Settings Update Detected, Update Now ? [y/N] " response
response=${response,,}
if [[ "$response" =~ ^(yes|y)$ ]]; then
    echo "Applying Updated Configs"
    sudo pacman -Syyu --noconfirm --needed mkinitcpio-firmware
    sudo cp -Rf /etc/skel/.config/yay "$HOME/.config/" 2>/dev/null || true
    sudo rm /usr/local/bin/upgrade
    sudo mv /usr/local/bin/noupgrade /usr/local/bin/upgrade 2>/dev/null || true
    echo "All Done ! Enjoy ;)"
    sleep 5
else
    echo "OK, then. Skipping System upgrade."
    exit
fi