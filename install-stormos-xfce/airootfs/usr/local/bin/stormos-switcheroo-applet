#!/usr/bin/env python3
"""
StormOS Switcheroo-Control Applet
System tray applet for GPU switching with Intel/AMD/Nvidia hybrid support.
Handles: Intel+AMD, Intel+Nvidia, AMD+Nvidia, AMD+AMD, and single GPU setups.
"""

import subprocess
import sys
import os
import re

try:
    from PyQt5.QtWidgets import (QApplication, QSystemTrayIcon, QMenu,
                                  QAction, QMessageBox, QInputDialog)
    from PyQt5.QtGui import QIcon
    from PyQt5.QtCore import QThread, pyqtSignal
except ImportError:
    print("Error: python-pyqt5 not installed")
    print("Install with: sudo pacman -S python-pyqt5")
    sys.exit(1)


def detect_gpus():
    """Detect GPUs via lspci and switcherooctl. Returns list of dicts."""
    gpus = []

    # Method 1: switcherooctl (most accurate)
    try:
        result = subprocess.run(['switcherooctl', 'list'],
                              capture_output=True, text=True, timeout=10)
        if result.returncode == 0 and result.stdout.strip():
            for line in result.stdout.strip().split('\n'):
                line = line.strip()
                if not line or line.startswith('Device') or line.startswith('-----'):
                    continue
                # Parse switcheroo output like:
                # "Device: /dev/dri/card0  integrated  Intel ..."
                # "Device: /dev/dri/card1  discrete    AMD ..."
                gpu = {'raw': line}
                if 'integrated' in line.lower():
                    gpu['type'] = 'integrated'
                elif 'discrete' in line.lower():
                    gpu['type'] = 'discrete'
                else:
                    gpu['type'] = 'unknown'

                # Detect vendor
                upper = line.upper()
                if 'NVIDIA' in upper or 'NVS' in upper or 'GEFORCE' in upper or 'RTX' in upper or 'GTX' in upper:
                    gpu['vendor'] = 'nvidia'
                elif 'AMD' in upper or 'ATI' in upper or 'RADEON' in upper:
                    gpu['vendor'] = 'amd'
                elif 'INTEL' in upper:
                    gpu['vendor'] = 'intel'
                else:
                    gpu['vendor'] = 'unknown'

                # Extract card path
                match = re.search(r'/dev/dri/card\d+', line)
                if match:
                    gpu['card'] = match.group(0)

                gpus.append(gpu)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass

    # Method 2: lspci fallback if switcherooctl gave nothing
    if not gpus:
        try:
            result = subprocess.run(['lspci'], capture_output=True, text=True, timeout=10)
            if result.returncode == 0:
                for line in result.stdout.split('\n'):
                    line_lower = line.lower()
                    if 'vga' in line_lower or '3d' in line_lower or 'display' in line_lower:
                        gpu = {'raw': line.strip()}
                        if 'nvidia' in line_lower:
                            gpu['vendor'] = 'nvidia'
                        elif 'amd' in line_lower or 'ati' in line_lower or 'radeon' in line_lower:
                            gpu['vendor'] = 'amd'
                        elif 'intel' in line_lower:
                            gpu['vendor'] = 'intel'
                        else:
                            gpu['vendor'] = 'unknown'
                        gpu['type'] = 'unknown'
                        gpus.append(gpu)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            pass

    return gpus


def get_gpu_pair_type(gpus):
    """Determine the hybrid GPU configuration type."""
    vendors = set(g.get('vendor', 'unknown') for g in gpus)
    if len(gpus) <= 1:
        return 'single', vendors
    if 'intel' in vendors and 'nvidia' in vendors:
        return 'intel-nvidia', vendors
    if 'intel' in vendors and 'amd' in vendors:
        return 'intel-amd', vendors
    if 'amd' in vendors and 'nvidia' in vendors:
        return 'amd-nvidia', vendors
    if vendors == {'amd'}:
        return 'amd-amd', vendors
    return 'unknown', vendors


class GPUSwitcher(QThread):
    finished = pyqtSignal(str)
    error = pyqtSignal(str)

    def run(self):
        try:
            result = subprocess.run(['switcherooctl', 'list'],
                                  capture_output=True, text=True, timeout=10)
            if result.returncode == 0:
                self.finished.emit(result.stdout)
            else:
                self.error.emit("switcherooctl not available")
        except FileNotFoundError:
            self.error.emit("switcheroo-control not installed")
        except subprocess.TimeoutExpired:
            self.error.emit("switcherooctl timed out")
        except Exception as e:
            self.error.emit(str(e))


class StormOSSwitcherooApplet(QSystemTrayIcon):
    def __init__(self, parent=None):
        super().__init__(parent)

        # Set icon
        for icon_path in [
            "/usr/share/pixmaps/stormos/whiskermenu-bolt.svg",
            "/usr/share/icons/stormos/switcheroo.png",
            "/usr/share/pixmaps/stormos.png",
        ]:
            if os.path.exists(icon_path):
                self.setIcon(QIcon(icon_path))
                break
        else:
            self.setIcon(QIcon.fromTheme("video-display"))

        # Detect GPUs
        self.gpus = detect_gpus()
        self.pair_type, self.vendors = get_gpu_pair_type(self.gpus)

        # Build tooltip
        vendor_names = {'intel': 'Intel', 'amd': 'AMD', 'nvidia': 'Nvidia', 'unknown': 'Unknown'}
        gpu_list = ', '.join(vendor_names.get(v, v) for v in self.vendors)
        self.setToolTip(f"StormOS GPU Switcher — {gpu_list}")

        # Build menu
        self.build_menu()

        # Start background detection
        self.gpu_thread = GPUSwitcher()
        self.gpu_thread.finished.connect(self.on_gpu_info)
        self.gpu_thread.error.connect(self.on_gpu_error)
        self.gpu_thread.start()

    def build_menu(self):
        self.menu = QMenu()

        # GPU info
        info_action = QAction("GPU Information", self)
        info_action.triggered.connect(self.show_gpu_info)
        self.menu.addAction(info_action)

        # Detected config
        config_action = QAction(f"Config: {self.pair_type}", self)
        config_action.setEnabled(False)
        self.menu.addAction(config_action)

        self.menu.addSeparator()

        # ── Intel + AMD hybrid ──
        if self.pair_type == 'intel-amd':
            use_intel = QAction("Use Intel iGPU (power save)", self)
            use_intel.triggered.connect(lambda: self.switch_gpu("intel"))
            self.menu.addAction(use_intel)

            use_amd = QAction("Use AMD dGPU (performance)", self)
            use_amd.triggered.connect(lambda: self.switch_gpu("amd"))
            self.menu.addAction(use_amd)

            self.menu.addSeparator()

            launch_amd = QAction("Launch App on AMD GPU", self)
            launch_amd.triggered.connect(lambda: self.launch_app("amd"))
            self.menu.addAction(launch_amd)

            launch_intel = QAction("Launch App on Intel GPU", self)
            launch_intel.triggered.connect(lambda: self.launch_app("intel"))
            self.menu.addAction(launch_intel)

        # ── Intel + Nvidia hybrid ──
        elif self.pair_type == 'intel-nvidia':
            use_intel = QAction("Use Intel iGPU (power save)", self)
            use_intel.triggered.connect(lambda: self.switch_gpu("intel"))
            self.menu.addAction(use_intel)

            use_nvidia = QAction("Use Nvidia dGPU (performance)", self)
            use_nvidia.triggered.connect(lambda: self.switch_gpu("nvidia"))
            self.menu.addAction(use_nvidia)

            self.menu.addSeparator()

            launch_nvidia = QAction("Launch App on Nvidia GPU", self)
            launch_nvidia.triggered.connect(lambda: self.launch_app("nvidia"))
            self.menu.addAction(launch_nvidia)

            launch_intel = QAction("Launch App on Intel GPU", self)
            launch_intel.triggered.connect(lambda: self.launch_app("intel"))
            self.menu.addAction(launch_intel)

        # ── AMD + Nvidia hybrid ──
        elif self.pair_type == 'amd-nvidia':
            use_amd_int = QAction("Use AMD iGPU (power save)", self)
            use_amd_int.triggered.connect(lambda: self.switch_gpu("amd"))
            self.menu.addAction(use_amd_int)

            use_nvidia = QAction("Use Nvidia dGPU (performance)", self)
            use_nvidia.triggered.connect(lambda: self.switch_gpu("nvidia"))
            self.menu.addAction(use_nvidia)

            self.menu.addSeparator()

            launch_nvidia = QAction("Launch App on Nvidia GPU", self)
            launch_nvidia.triggered.connect(lambda: self.launch_app("nvidia"))
            self.menu.addAction(launch_nvidia)

            launch_amd = QAction("Launch App on AMD GPU", self)
            launch_amd.triggered.connect(lambda: self.launch_app("amd"))
            self.menu.addAction(launch_amd)

        # ── AMD + AMD (dual AMD, e.g. APU + discrete) ──
        elif self.pair_type == 'amd-amd':
            use_integrated = QAction("Use Integrated AMD (power save)", self)
            use_integrated.triggered.connect(lambda: self.switch_gpu("integrated"))
            self.menu.addAction(use_integrated)

            use_discrete = QAction("Use Discrete AMD (performance)", self)
            use_discrete.triggered.connect(lambda: self.switch_gpu("discrete"))
            self.menu.addAction(use_discrete)

            self.menu.addSeparator()

            launch_discrete = QAction("Launch App on Discrete AMD", self)
            launch_discrete.triggered.connect(lambda: self.launch_app("discrete"))
            self.menu.addAction(launch_discrete)

        # ── Single or unknown GPU ──
        else:
            if len(self.gpus) == 0:
                no_gpu = QAction("No GPU detected", self)
                no_gpu.setEnabled(False)
                self.menu.addAction(no_gpu)
            else:
                for i, gpu in enumerate(self.gpus):
                    vendor = gpu.get('vendor', 'unknown').upper()
                    gtype = gpu.get('type', 'unknown')
                    gpu_action = QAction(f"GPU {i}: {vendor} ({gtype})", self)
                    gpu_action.setEnabled(False)
                    self.menu.addAction(gpu_action)

            # Still offer launch options if switcherooctl works
            self.menu.addSeparator()
            launch_prime = QAction("Launch App on GPU 1", self)
            launch_prime.triggered.connect(lambda: self.launch_app("discrete"))
            self.menu.addAction(launch_prime)

        # ── Common menu items ──
        self.menu.addSeparator()

        about_action = QAction("About StormOS GPU Switcher", self)
        about_action.triggered.connect(self.show_about)
        self.menu.addAction(about_action)

        quit_action = QAction("Quit", self)
        quit_action.triggered.connect(QApplication.quit)
        self.menu.addAction(quit_action)

        self.setContextMenu(self.menu)

    def show_gpu_info(self):
        """Show detailed GPU information dialog."""
        info_parts = ["=== GPU Information ===\n"]

        # lspci output
        try:
            result = subprocess.run(['lspci', '-v'], capture_output=True, text=True, timeout=10)
            vga_lines = []
            for line in result.stdout.split('\n'):
                if any(k in line.lower() for k in ['vga', '3d', 'display', 'audio']):
                    vga_lines.append(line)
            if vga_lines:
                info_parts.append("PCI Devices:\n" + '\n'.join(vga_lines[:15]))
        except Exception:
            pass

        # switcherooctl output
        info_parts.append("\n=== Switcheroo Status ===\n")
        try:
            result = subprocess.run(['switcherooctl', 'list'],
                                  capture_output=True, text=True, timeout=10)
            info_parts.append(result.stdout if result.returncode == 0 else "Not available")
        except Exception as e:
            info_parts.append(f"Error: {e}")

        # DRI status
        info_parts.append("\n=== DRI Devices ===\n")
        try:
            result = subprocess.run(['ls', '-la', '/dev/dri/'],
                                  capture_output=True, text=True, timeout=5)
            info_parts.append(result.stdout if result.returncode == 0 else "Not available")
        except Exception:
            info_parts.append("Not available")

        QMessageBox.information(self, "GPU Information", '\n'.join(info_parts))

    def switch_gpu(self, target):
        """Switch default GPU for new applications."""
        env_settings = []

        if target == "intel":
            env_settings.append(("DRI_PRIME", "0"))
            env_settings.append(("DRI_PRIME_RENDER_OFFLOAD", "0"))
            msg = "Switched to Intel GPU (power save mode)"
        elif target == "amd":
            env_settings.append(("DRI_PRIME", "1"))
            env_settings.append(("DRI_PRIME_RENDER_OFFLOAD", "1"))
            msg = "Switched to AMD GPU (performance mode)"
        elif target == "nvidia":
            env_settings.append(("DRI_PRIME", "1"))
            env_settings.append(("DRI_PRIME_RENDER_OFFLOAD", "1"))
            env_settings.append(("__NV_PRIME_RENDER_OFFLOAD", "1"))
            env_settings.append(("__GLX_VENDOR_LIBRARY_NAME", "nvidia"))
            msg = "Switched to Nvidia GPU (performance mode)"
        elif target == "discrete":
            env_settings.append(("DRI_PRIME", "1"))
            env_settings.append(("DRI_PRIME_RENDER_OFFLOAD", "1"))
            msg = "Switched to discrete GPU (performance mode)"
        else:
            env_settings.append(("DRI_PRIME", "0"))
            msg = "Switched to integrated GPU (power save mode)"

        try:
            # Remove old StormOS GPU settings
            profile_path = os.path.expanduser("~/.profile")
            if os.path.exists(profile_path):
                with open(profile_path, 'r') as f:
                    lines = f.readlines()
                with open(profile_path, 'w') as f:
                    skip = False
                    for line in lines:
                        if '# StormOS GPU Switch' in line:
                            skip = True
                        elif skip and line.startswith('export DRI_PRIME') or \
                             skip and line.startswith('export __NV_') or \
                             skip and line.startswith('export __GLX_'):
                            continue
                        elif skip and not line.strip().startswith('export'):
                            skip = False
                        f.write(line)

            # Write new settings
            with open(profile_path, 'a') as f:
                f.write("\n# StormOS GPU Switch\n")
                for key, val in env_settings:
                    f.write(f"export {key}={val}\n")

            QMessageBox.information(self, "GPU Switched",
                f"{msg}\n\nNew applications will use this GPU.\n"
                "Log out and back in for full effect.")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Failed to switch GPU:\n{str(e)}")

    def launch_app(self, target):
        """Launch an application on a specific GPU."""
        app_name, ok = QInputDialog.getText(self, f"Launch on {target.upper()} GPU",
            "Enter application name or command:")

        if not ok or not app_name:
            return

        env = os.environ.copy()

        if target == "intel":
            env['DRI_PRIME'] = '0'
            env['DRI_PRIME_RENDER_OFFLOAD'] = '0'
        elif target == "amd":
            env['DRI_PRIME'] = '1'
            env['DRI_PRIME_RENDER_OFFLOAD'] = '1'
        elif target == "nvidia":
            env['DRI_PRIME'] = '1'
            env['DRI_PRIME_RENDER_OFFLOAD'] = '1'
            env['__NV_PRIME_RENDER_OFFLOAD'] = '1'
            env['__GLX_VENDOR_LIBRARY_NAME'] = 'nvidia'
        elif target == "discrete":
            env['DRI_PRIME'] = '1'
            env['DRI_PRIME_RENDER_OFFLOAD'] = '1'
        else:
            env['DRI_PRIME'] = '0'

        try:
            # Try switcherooctl first (most reliable)
            if subprocess.run(['which', 'switcherooctl'],
                            capture_output=True).returncode == 0:
                subprocess.Popen(['switcherooctl', 'launch', app_name.split()[0]] + app_name.split()[1:],
                               env=env)
            else:
                subprocess.Popen(app_name.split(), env=env)
        except Exception as e:
            QMessageBox.critical(self, "Error",
                f"Failed to launch application:\n{str(e)}")

    def show_about(self):
        QMessageBox.about(self, "About StormOS GPU Switcher",
            "<h3>StormOS GPU Switcher</h3>"
            "<p>System tray applet for GPU switching</p>"
            f"<p>Detected: {self.pair_type}</p>"
            "<p>Supports: Intel, AMD, Nvidia hybrid setups</p>"
            "<p>Part of StormOS Linux</p>")

    def on_gpu_info(self, info):
        self.setToolTip(f"StormOS GPU Switcher\n{info[:60]}...")

    def on_gpu_error(self, error):
        self.setToolTip(f"StormOS GPU Switcher\nError: {error}")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("StormOS GPU Switcher")
    app.setQuitOnLastWindowClosed(False)

    if not QSystemTrayIcon.isSystemTrayAvailable():
        QMessageBox.critical(None, "System Tray",
            "System tray is not available on this system.")
        sys.exit(1)

    switcher = StormOSSwitcherooApplet()
    switcher.show()

    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
