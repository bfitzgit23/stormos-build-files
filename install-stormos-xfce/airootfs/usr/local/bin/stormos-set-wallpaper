#!/bin/bash
# StormOS wallpaper setter — runs on every login to ensure wallpaper loads
WALLPAPER="/usr/share/backgrounds/stormos-wallpaper.png"

if [ ! -f "$WALLPAPER" ]; then
    echo "Wallpaper not found: $WALLPAPER" >&2
    exit 1
fi

# Wait for desktop to initialize
sleep 2

# Method 1: xfconf-query (works if xfconfd is running)
if command -v xfconf-query >/dev/null 2>&1; then
    # Set for all backdrop properties
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace0/image-path -s "$WALLPAPER" 2>/dev/null
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace1/image-path -s "$WALLPAPER" 2>/dev/null
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace2/image-path -s "$WALLPAPER" 2>/dev/null
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace3/image-path -s "$WALLPAPER" 2>/dev/null
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace0/last-image -s "$WALLPAPER" 2>/dev/null
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace1/last-image -s "$WALLPAPER" 2>/dev/null
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace2/last-image -s "$WALLPAPER" 2>/dev/null
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace3/last-image -s "$WALLPAPER" 2>/dev/null
    # Set image-style to 5 (zoomed) for all
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace0/image-style -n -t int -s 5 2>/dev/null
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace1/image-style -n -t int -s 5 2>/dev/null
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace2/image-style -n -t int -s 5 2>/dev/null
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/workspace3/image-style -n -t int -s 5 2>/dev/null
fi

# Method 2: Direct config file edit
XFCE_CONF="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml"
if [ -f "$XFCE_CONF" ]; then
    sed -i "s|<property name=\"image-path\" type=\"string\" value=\"[^\"]*\"/>|<property name=\"image-path\" type=\"string\" value=\"$WALLPAPER\"/>|g" "$XFCE_CONF"
    sed -i "s|<property name=\"last-image\" type=\"string\" value=\"[^\"]*\"/>|<property name=\"last-image\" type=\"string\" value=\"$WALLPAPER\"/>|g" "$XFCE_CONF"
fi

# Method 3: nitrogen fallback
if command -v nitrogen >/dev/null 2>&1; then
    nitrogen --set-zoom-fill "$WALLPAPER" 2>/dev/null
fi

# Method 4: feh fallback
if command -v feh >/dev/null 2>&1; then
    feh --bg-fill "$WALLPAPER" 2>/dev/null
fi

# Force xfdesktop reload
killall xfdesktop 2>/dev/null
sleep 1
xfdesktop --reload 2>/dev/null &
