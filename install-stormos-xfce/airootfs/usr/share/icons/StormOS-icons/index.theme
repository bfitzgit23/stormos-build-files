Directories=scalable/apps,scalable/places,scalable/mimetypes

[scalable/apps]
Size=48
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[scalable/places]
Size=48
MinSize=16
MaxSize=512
Context=Places
Type=Scalable

[scalable/mimetypes]
Size=48
MinSize=16
MaxSize=512
Context=MimeTypes
Type=Scalable
