/*
 * StormOS Calamares Dark Theme Stylesheet
 * Honors adw-gtk3 / dark theme aesthetics
 * Palette: Catppuccin Mocha-inspired with warm accent
 */

/* ---- Color Palette ----
 * Base:      #1a1b26   (deep navy-black)
 * Surface:   #16161e   (panel background)
 * Border:    #2a2d3a   (subtle borders)
 * Text:      #e0e5f0   (primary text)
 * Muted:     #9198b3   (secondary text)
 * Accent:    #f07178   (warm red-pink, buttons/hover)
 * Success:   #9ece6a   (green, progress bar)
 * Warning:   #e0af68   (orange, errors)
 * Scrollbar: #45475a   (scrollbar handle)
 */

/* ########## MAIN APPLICATION WINDOW ########## */

#mainApp {
    background-color: #1a1b26;
    color: #e0e5f0;
}

#mainText {
    font: bold 18px "Noto Sans";
    color: #e0e5f0;
}

#sidebarApp {
    background-color: #16161e;
}

#logoApp {
}

#sidebarMenuApp {
    padding: 4px;
    background-color: #16161e;
}

QWidget {
    font: 13px "Noto Sans";
    color: #e0e5f0;
    background-color: #1a1b26;
}

QTextEdit, QListView {
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
}

QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

QAbstractSpinBox {
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 4px;
}

QListWidget::item:alternate {
    background-color: #16161e;
}

/* ---- Navigation Buttons (bottom bar) ---- */

#view-button-back {
    color: #9198b3;
    border: none;
    background: transparent;
    padding: 8px 16px;
    border-radius: 6px;
}
#view-button-back:hover {
    background-color: #2a2d3a;
    color: #f07178;
}
#view-button-next {
    color: #9198b3;
    border: none;
    background: transparent;
    padding: 8px 16px;
    border-radius: 6px;
}
#view-button-next:hover {
    background-color: #2a2d3a;
    color: #f07178;
}
#view-button-cancel {
    color: #9198b3;
    border: 1px solid #2a2d3a;
    background: transparent;
    padding: 8px 16px;
    border-radius: 6px;
}
#view-button-cancel:hover {
    background-color: #2a2d3a;
    color: #e0af68;
}

#debugButton {
    font: bold 9px "Noto Sans";
    color: #9198b3;
    background-color: #1a1b26;
    border: 1px solid #2a2d3a;
    border-radius: 4px;
    padding: 4px 8px;
}
#debugButton:hover {
    background-color: #2a2d3a;
    color: #f07178;
}

#aboutButton:hover {
    color: #f07178;
}
#donateButton:hover {
    color: #f07178;
}
#supportButton:hover {
    color: #f07178;
}
#knownIssuesButton:hover {
    color: #f07178;
}
#releaseNotesButton:hover {
    color: #f07178;
}

/* ########## TOOLTIP ########## */

QToolTip {
    background-color: #2a2d3a;
    color: #e0e5f0;
    font: 12px "Noto Sans";
    padding: 6px 10px;
    border: none;
    border-radius: 6px;
}

QPushButton {
    font: 13px "Noto Sans";
    color: #e0e5f0;
    background-color: #1a1b26;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px 16px;
}

QPushButton:hover {
    background-color: #2a2d3a;
    color: #f07178;
}

/* ########## SCROLL BAR ########## */

QScrollBar:vertical {
    background: #1a1b26;
    width: 10px;
    margin: 4px 0 4px 0;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #45475a;
    max-height: 25px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #585b70;
}

QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 10px;
    subcontrol-position: top;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical {
    border: none;
    background: none;
    height: 10px;
    subcontrol-position: bottom;
    subcontrol-origin: margin;
}

/* ########## QLIST VIEW ########## */

QListView {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
}

QListView::item:alternate {
    background-color: #16161e;
    color: #e0e5f0;
}

QListView::item:!alternate:selected:active {
    background-color: #2a2d3a;
    color: #f07178;
}

QListView::item:selected:active {
    background-color: #2a2d3a;
    color: #f07178;
}

QListView::item:selected:!active {
    background-color: #2a2d3a;
    color: #f07178;
}

QListView::item:hover {
    background-color: #2a2d3a;
    color: #e0e5f0;
}

QListView#listLayout::item:!alternate:selected:active {
    background-color: #2a2d3a;
    color: #f07178;
}

QListView#listVariant::item:!alternate:selected:active {
    background-color: #2a2d3a;
    color: #f07178;
}

/* ########## QLINE EDIT ########## */

QLineEdit#LE_TestKeyboard {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}

QLineEdit#m_passphraseLineEdit, QLineEdit#vgName,
QLineEdit#m_confirmLineEdit {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}

QLineEdit#textBoxUserVerifiedPassword, QLineEdit#textBoxVerifiedRootPassword {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}

QLineEdit#textBoxFullName, QLineEdit#textBoxLoginName, QLineEdit#textBoxHostName,
QLineEdit#textBoxUserPassword, QLineEdit#textBoxRootPassword {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}

#textBoxFullName, #textBoxLoginName, #textBoxHostName, #textBoxUserPassword,
#textBoxRootPassword, #textBoxAutoLogin, #vgName {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}

#textBoxUserVerifiedPassword, #textBoxVerifiedRootPassword,
#LE_TestKeyboard, #m_confirmLineEdit, #m_passphraseLineEdit {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}

/* ##########PARTITION ########## */

#partitionLabel {
    color: #9198b3;
}

#partitionLabelsView {
}

#CreatePartitionDialog {
    background-color: #1a1b26;
}

#partResizerWidget {
    font: 13px "Noto Sans";
}

/* ########## PAGE_USERSETUP ########## */

#labelWhatIsYourName {
    font: 13px "Noto Sans";
    color: #9198b3;
}
