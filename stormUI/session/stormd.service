# stormd.service — optional systemd user unit for the Storm system bridge.
#
# storm-session and the electron shell both start stormd themselves, so this
# unit is for everything else: scripts, the Storm Files app opened from a
# terminal, or head-less debugging. Enable it by hand, never automatically:
#
#   install -Dm644 stormd.service ~/.config/systemd/user/stormd.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now stormd
#
# If the port is already held by the session's own stormd, this unit fails
# quietly on bind — that is the expected "already running" behaviour and not
# an error. architecture/stage3-arch.sh --install does this for you.

[Unit]
Description=Storm system bridge (stormd, port 9876)

[Service]
ExecStart=/usr/bin/python3 /usr/lib/stormui/backend/stormd.py --port 9876
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
