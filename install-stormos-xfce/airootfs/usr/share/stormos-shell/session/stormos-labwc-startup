#!/usr/bin/env bash
# StormOS startup hook for labwc.
# Every component is launched independently so one failure does not stop the session.

set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/stormos"
mkdir -p "$STATE_DIR"

log_start() {
    name="$1"
    shift
    "$@" >>"$STATE_DIR/${name}.log" 2>&1 &
    echo $! >"$STATE_DIR/${name}.pid"
}

export XDG_CURRENT_DESKTOP=StormOS
export XDG_SESSION_DESKTOP=stormos
export XDG_SESSION_TYPE=wayland
export GTK_USE_PORTAL=1
export GDK_BACKEND=wayland
export GTK_THEME=StormOS-GTK
export GTK4_THEME=StormOS-GTK
export XCURSOR_THEME=StormOS-icons
export XCURSOR_SIZE=24
export XDG_DATA_DIRS="/usr/share:$HOME/.local/share:${XDG_DATA_DIRS:-}"
export GIO_USE_VFS=gvfs
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus}"

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd         DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP         XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS GTK_THEME GTK4_THEME         XCURSOR_THEME XCURSOR_SIZE XDG_DATA_DIRS GIO_USE_VFS         >>"$STATE_DIR/environment.log" 2>&1 || true
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment         DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP         XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS GTK_THEME GTK4_THEME         XCURSOR_THEME XCURSOR_SIZE XDG_DATA_DIRS GIO_USE_VFS         >>"$STATE_DIR/environment.log" 2>&1 || true
fi

# Start volume services only when available.
if command -v gvfsd >/dev/null 2>&1; then
    log_start gvfs gvfsd
fi
if command -v gvfs-udisks2-volume-monitor >/dev/null 2>&1; then
    log_start gvfs-udisks2 gvfs-udisks2-volume-monitor
fi
if command -v gvfs-metadata >/dev/null 2>&1; then
    log_start gvfs-metadata gvfs-metadata
fi

# Polkit authentication agent.
if [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
    log_start polkit /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
elif command -v lxqt-policykit-agent >/dev/null 2>&1; then
    log_start polkit lxqt-policykit-agent
fi

# Native bridge.
if [ -x /usr/bin/stormos-bridge ]; then
    log_start bridge /usr/bin/stormos-bridge
fi

# Wallpaper.
if command -v swaybg >/dev/null 2>&1 && [ -f /usr/share/backgrounds/stormos/stormos-wallpaper.svg ]; then
    log_start swaybg swaybg -i /usr/share/backgrounds/stormos/stormos-wallpaper.svg -m fill
fi

# Waybar.
if command -v waybar >/dev/null 2>&1; then
    log_start waybar waybar
fi

# React shell host.
if [ -x /usr/bin/stormos-shell-host ]; then
    log_start shell-host /usr/bin/stormos-shell-host
else
    printf '%s\n' "Missing /usr/bin/stormos-shell-host" >"$STATE_DIR/shell-host.log"
fi
