#!/usr/bin/env bash
set -Eeuo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/foot/foot.ini"
mkdir -p "$(dirname "$config")"

# Use the physical display size when available. Fall back to a sensible
# desktop size. Font scales with the smaller display dimension.
width=1920
height=1080
if command -v xrandr >/dev/null 2>&1; then
    mode="$(xrandr --current 2>/dev/null | awk '/ connected/{print $3; exit}')"
    if [[ "$mode" =~ ^([0-9]+)x([0-9]+) ]]; then
        width="${BASH_REMATCH[1]}"
        height="${BASH_REMATCH[2]}"
    fi
elif command -v wlr-randr >/dev/null 2>&1; then
    mode="$(wlr-randr 2>/dev/null | awk '/current/{print $1; exit}')"
    if [[ "$mode" =~ ^([0-9]+)x([0-9]+) ]]; then
        width="${BASH_REMATCH[1]}"
        height="${BASH_REMATCH[2]}"
    fi
fi

min_dim=$(( width < height ? width : height ))
font_size=11
if (( min_dim >= 1800 )); then font_size=13
elif (( min_dim >= 1400 )); then font_size=12
elif (( min_dim <= 900 )); then font_size=10
fi

# Foot supports per-launch overrides and native Wayland alpha.
exec foot \
  --config "$config" \
  --font "JetBrains Mono:size=${font_size}" \
  --app-id "stormos-foot" \
  "$@"
