# StormOS Openbox Theme
# Dark with electric blue accents

ob.theme = StormOS-GTK

# Titlebar
titleLayout = NLIMC
keepBorder = yes
animateIconify = yes

# Font
font Active = "Inter Bold 10"
font Inactive = "Inter 10"
font MenuHeader = "Inter Bold 10"
font Menu = "Inter 10"

# Colors
osd.border.color = #19a9ff
osd.border.size = 1
osd.shadow.size = 6
osd.shadow.color = #000000
osd.border.focused.color = #19a9ff
osd.border.unfocused.color = #1e4a6e

# Window active
window.active.title.bg.color = #142a42
window.active.title.bg.colorTo = #0f1f35
window.active.border.color = #19a9ff
window.active.handle.color = #1e4a6e

# Window inactive
window.inactive.title.bg.color = #0a1628
window.inactive.title.bg.colorTo = #0a1628
window.inactive.border.color = #1e4a6e
window.inactive.handle.color = #142a42

# Buttons
window.active.button.unpressed.bg.color = #142a42
window.active.button.unpressed.bg.colorTo = #0f1f35
window.active.button.pressed.bg.color = #19a9ff
window.active.button.pressed.bg.colorTo = #0876c9
window.inactive.button.unpressed.bg.color = #0a1628
window.inactive.button.unpressed.bg.colorTo = #0a1628

# Close button
window.active.button.close.unpressed.bg.color = #e74c3c
window.active.button.close.pressed.bg.color = #c0392b
window.inactive.button.close.unpressed.bg.color = #1e4a6e

# Maximize button
window.active.button.maximize.unpressed.bg.color = #2ecc71
window.active.button.maximize.pressed.bg.color = #27ae60
window.inactive.button.maximize.unpressed.bg.color = #1e4a6e

# Minimize button
window.active.button.minimize.unpressed.bg.color = #f39c12
window.active.button.minimize.pressed.bg.color = #e67e22
window.inactive.button.minimize.unpressed.bg.color = #1e4a6e

# Menu
menu.items.bg.color = #142a42
menu.items.bg.colorTo = #142a42
menu.items.text.color = #e8f2ff
menu.items.text.active.color = #19a9ff
menu.border.color = #1e4a6e
menu.separator.color = #1e4a6e
menu.separator.width = 1

# Toolbar
toolbar.bg.color = #0f1f35
toolbar.bg.colorTo = #0f1f35

# Slit and Dock
slit.bg.color = #142a42
slit.bg.colorTo = #142a42
dock.bg.color = #142a42
dock.bg.colorTo = #142a42
