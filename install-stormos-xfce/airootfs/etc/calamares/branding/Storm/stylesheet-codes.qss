    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}
#labelFullName {
    font: 13px "Noto Sans";
    color: #9198b3;
}
#labelFullNameError {
    font: 13px "Noto Sans";
    color: #e0af68;
}
#username_label_2 {
    font: 13px "Noto Sans";
    color: #9198b3;
}
#textBoxLoginName {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}
#labelUsername {
    font: 13px "Noto Sans";
    color: #9198b3;
}
#labelUsernameError {
    font: 13px "Noto Sans";
    color: #e0af68;
}
#hostname_label_2 {
    font: 13px "Noto Sans";
    color: #9198b3;
}
#textBoxHostName {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}
#labelHostname {
    font: 13px "Noto Sans";
    color: #9198b3;
}
#labelHostnameError {
    font: 13px "Noto Sans";
    color: #e0af68;
}
#password_label_2 {
    font: 13px "Noto Sans";
    color: #9198b3;
}
#textBoxUserPassword {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}
#labelUserPassword {
    font: 13px "Noto Sans";
    color: #9198b3;
}
#labelUserPasswordError {
    font: 13px "Noto Sans";
    color: #e0af68;
}
#checkBoxRequireStrongPassword {
    color: #e0e5f0;
}
#checkBoxDoAutoLogin {
    color: #e0e5f0;
}
#checkBoxReusePassword {
    color: #e0e5f0;
}
#labelChooseRootPassword {
    font: 13px "Noto Sans";
    color: #9198b3;
}
#textBoxRootPassword {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}
#labelRootPassword {
    font: 13px "Noto Sans";
    color: #9198b3;
}
#labelRootPasswordError {
    font: 13px "Noto Sans";
    color: #e0af68;
}

/* ########## COMBO BOX ########## */

QComboBox {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}

QComboBox:hover {
    background-color: #2a2d3a;
    color: #f07178;
}

QComboBox::item:selected {
    background-color: #2a2d3a;
    color: #f07178;
}

QComboBox::item {
    padding: 6px;
    color: #e0e5f0;
}

QComboBox::item:hover {
    background-color: #2a2d3a;
    color: #f07178;
}

#mountPointComboBox::drop-down {
    font: 13px "Noto Sans";
}

/* ########## SPIN BOX ########## */

QSpinBox {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}

QLineEdit {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    padding: 6px;
}

/* ########## TREE VIEW ########## */

QTreeView {
    font: 13px "Noto Sans";
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    show-decoration-selected: 0;
}

QTreeView::item {
    padding: 4px 8px;
    color: #e0e5f0;
}

QTreeView::item:selected {
    background-color: #2a2d3a;
    color: #f07178;
    font: bold;
}

QTreeView::item:hover {
    background-color: #2a2d3a;
    color: #e0e5f0;
}

QTreeView::branch:has-siblings:!adjoins-item {
    border: none;
}
QTreeView::branch:has-siblings:adjoins-item {
    border: none;
}
QTreeView::branch:!has-children:!has-siblings:adjoins-item {
    border: none;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border: none;
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings  {
    border: none;
}

/* ########## CHECK BOX ########## */

QCheckBox {
    color: #e0e5f0;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    background-color: #1a1b26;
    border: 1px solid #45475a;
    border-radius: 4px;
}

QCheckBox::indicator:unchecked:hover {
    border-color: #f07178;
}

QCheckBox::indicator:checked {
    background-color: #f07178;
    border: 1px solid #f07178;
    border-radius: 4px;
}

QCheckBox::indicator:checked:hover {
    background-color: #e0af68;
}

QItemSelectionModel::Select {
}

/* ########## HEADER VIEW ########## */

QHeaderView::section {
    font: 13px "Noto Sans";
    background-color: #16161e;
    color: #9198b3;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #2a2d3a;
}

/* ########## PROGRESS BAR ########## */

QProgressBar {
    text-align: center;
    background-color: #1a1b26;
    color: #e0e5f0;
    border: 1px solid #2a2d3a;
    border-radius: 6px;
    height: 8px;
}

QProgressBar::chunk {
    background-color: #9ece6a;
    border-radius: 3px;
}

QProgressBar::text {
    color: #e0e5f0;
}

/* ########## INSTALLER PROGRESS BAR (in bottom bar) ########## */

#installProgressBar {
    height: 4px;
    background-color: #2a2d3a;
    border-radius: 2px;
}

#installProgressBar::chunk {
    background-color: #f07178;
    border-radius: 2px;
}
