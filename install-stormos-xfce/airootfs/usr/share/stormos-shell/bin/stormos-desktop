#!/usr/bin/env bash
# stormos-desktop — StormOS React desktop shell launcher.
#
# Designed to work as:
#   - A LightDM session (Exec= in .desktop file)
#   - An .xinitrc target (exec stormos-desktop)
#   - A manual launcher from a TTY
#
# IMPORTANT: This script MUST stay alive as the foreground process.
# LightDM kills everything when the session script exits.
# We do NOT use 'exec' for electron — if it crashes, we show an
# error in xterm and wait so openbox stays alive.

set -uo pipefail

LOG="$HOME/.stormos-desktop.log"
log() { echo "[$(date '+%H:%M:%S')] $*" >> "$LOG"; }

log "=== stormos-desktop starting (pid $$) ==="
log "HOME=$HOME USER=$(whoami) DISPLAY=$DISPLAY"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="${STORMOS_DESKTOP_DIR:-/usr/share/stormos-shell}"

# Fallback: if installed via the project dir, use that
[ -f "$PROJECT_DIR/main.js" ] || PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

log "PROJECT_DIR=$PROJECT_DIR SCRIPT_DIR=$SCRIPT_DIR"

export STORMOS_BRIDGE_PORT="${STORMOS_BRIDGE_PORT:-47821}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-StormOS}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-stormos}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}"

# Disable screen blanking and DPMS
xset s off -dpms 2>/dev/null || true
xset s noblank 2>/dev/null || true

PIDS=()
cleanup() {
    log "=== cleaning up ==="
    for pid in "${PIDS[@]:-}"; do
        kill "$pid" 2>/dev/null || true
    done
}
trap cleanup EXIT INT TERM

# --- 1. Python system bridge ---
if [ -f "$PROJECT_DIR/native/stormos-bridge.py" ]; then
    log "Starting bridge..."
    python3 "$PROJECT_DIR/native/stormos-bridge.py" \
        >"$HOME/.stormos-bridge.log" 2>&1 &
    PIDS+=($!)
    for i in $(seq 1 30); do
        if curl -sf "http://127.0.0.1:$STORMOS_BRIDGE_PORT/api/health" >/dev/null 2>&1; then
            log "Bridge ready"
            break
        fi
        sleep 0.2
    done
else
    log "No bridge found at $PROJECT_DIR/native/stormos-bridge.py"
fi

# --- 2. Optional: invisible openbox ---
if command -v openbox-session >/dev/null 2>&1 && [ "${STORMOS_USE_OPENBOX:-1}" = "1" ]; then
    log "Starting openbox..."
    openbox-session >/dev/null 2>&1 &
    PIDS+=($!)
    sleep 0.5
else
    log "openbox not available, skipping"
fi

# --- 3. Electron desktop shell ---
show_error() {
    # Show an error dialog so the user knows what went wrong
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="StormOS Desktop" --text="$1" --width=400 2>/dev/null &
    elif command -v xterm >/dev/null 2>&1; then
        xterm -title "StormOS Desktop Error" -e "echo '$1'; sleep 10" &
    fi
    log "ERROR: $1"
}

if ! command -v electron >/dev/null 2>&1; then
    show_error "electron not found. Install with: sudo pacman -S electron"
    # Keep the script alive so openbox stays running
    wait
    exit 1
fi

log "Electron found at: $(which electron)"

# Build the React frontend if dist/ doesn't exist or source changed
if [ ! -d "$PROJECT_DIR/dist" ] || [ "$PROJECT_DIR/src/main.jsx" -nt "$PROJECT_DIR/dist/index.html" ] 2>/dev/null; then
    log "Building React frontend..."
    cd "$PROJECT_DIR" && npm run build 2>/dev/null || true
fi

log "dist/ exists: $(test -d "$PROJECT_DIR/dist" && echo YES || echo NO)"

# Run electron in the foreground — but do NOT use 'exec'.
# If electron crashes, we fall through to the error handler below.
if [ -d "$PROJECT_DIR/dist" ]; then
    log "Launching Electron (production)..."
    electron "$PROJECT_DIR" --no-sandbox "$@"
    EXIT_CODE=$?
else
    log "Launching Electron (dev mode)..."
    cd "$PROJECT_DIR" && npm run dev "$@"
    EXIT_CODE=$?
fi

# If we get here, electron exited (crash or clean exit)
if [ "$EXIT_CODE" -ne 0 ]; then
    show_error "Electron exited with code $EXIT_CODE. Check ~/.stormos-desktop.log"
fi

log "Electron exited with code $EXIT_CODE"
# Keep alive so openbox doesn't get killed by LightDM
wait
