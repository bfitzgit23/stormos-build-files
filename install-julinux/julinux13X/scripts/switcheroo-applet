#!/usr/bin/env python3
"""
JULinux Switcheroo-Control Applet
GPU switching using switcheroo-control.
Falls back to a regular window if the system tray is unavailable (common on XFCE).
"""

import subprocess
import sys
import os

from PyQt5.QtWidgets import (
    QApplication, QSystemTrayIcon, QMenu, QAction, QMessageBox,
    QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton, QMainWindow,
    QTextEdit, QGroupBox, QInputDialog, QFrame
)
from PyQt5.QtGui import QIcon, QFont, QColor
from PyQt5.QtCore import QThread, pyqtSignal, Qt

# ── Colors ───────────────────────────────────────────────────────────────────
NAVY  = "#0a192f"
BLUE  = "#19A9FF"
LIGHT = "#E8F2FF"
DARK  = "#020c1b"
GLASS = "rgba(2, 12, 27, 0.85)"
GREEN = "#4ADE80"
CORAL = "#ff6b6b"


class GPUSwitcher(QThread):
    finished = pyqtSignal(str)
    error    = pyqtSignal(str)

    def run(self):
        try:
            result = subprocess.run(["switcherooctl", "list"],
                                    capture_output=True, text=True, timeout=10)
            if result.returncode == 0:
                self.finished.emit(result.stdout)
            else:
                self.error.emit("switcherooctl returned error")
        except FileNotFoundError:
            self.error.emit("switcheroo-control not installed")
        except subprocess.TimeoutExpired:
            self.error.emit("switcherooctl timed out")
        except Exception as e:
            self.error.emit(str(e))


# ── Shared GPU logic ─────────────────────────────────────────────────────────
class GPUBackend:
    """Pure-logic class shared by both tray and window modes."""

    @staticmethod
    def get_gpu_info():
        try:
            r = subprocess.run(["switcherooctl", "list"],
                               capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                return r.stdout.strip()
        except Exception:
            pass
        # fallback: lspci
        try:
            r = subprocess.run(["lspci"], capture_output=True, text=True, timeout=5)
            lines = [l for l in r.stdout.splitlines()
                     if any(k in l.lower() for k in ("vga", "3d", "display"))]
            return "\n".join(lines) if lines else "No GPU info available"
        except Exception:
            return "No GPU info available"

    @staticmethod
    def switch_gpu(gpu_type):
        env_var = "DRI_PRIME=0" if gpu_type == "integrated" else "DRI_PRIME=1"
        profile = os.path.expanduser("~/.profile")
        # Remove old JULinux GPU switch lines first
        if os.path.exists(profile):
            with open(profile) as f:
                lines = [l for l in f.readlines()
                         if "# JULinux GPU Switch" not in l
                         and "DRI_PRIME" not in l]
            with open(profile, "w") as f:
                f.writelines(lines)
        # Append new
        with open(profile, "a") as f:
            f.write(f"\n# JULinux GPU Switch\nexport {env_var}\n")
        return "Switched to integrated GPU" if gpu_type == "integrated" \
            else "Switched to discrete GPU"

    @staticmethod
    def launch_on_gpu(command):
        env = {**os.environ, "DRI_PRIME": "1"}
        try:
            subprocess.Popen(["switcherooctl", "launch", command], env=env)
            return True
        except Exception:
            return False


# ── Window mode (when system tray is unavailable) ────────────────────────────
class SwitcherooWindow(QMainWindow):
    """Full QMainWindow fallback for XFCE without system tray."""

    def __init__(self):
        super().__init__()
        self.setWindowTitle("JULinux GPU Switcher")
        self.setMinimumSize(520, 460)
        self.gpu_info_text = ""

        central = QWidget()
        central.setObjectName("central")
        self.setCentralWidget(central)
        layout = QVBoxLayout(central)
        layout.setContentsMargins(20, 20, 20, 20)
        layout.setSpacing(14)

        # Title
        title = QLabel("JULinux GPU Switcher")
        title.setStyleSheet(f"font-size: 22px; font-weight: bold; color: {BLUE};")
        layout.addWidget(title)

        # GPU info card
        info_card = self._card("GPU Information")
        self.gpu_info = QLabel("Detecting GPUs...")
        self.gpu_info.setStyleSheet(f"color: {LIGHT}; font-size: 12px;")
        self.gpu_info.setWordWrap(True)
        self.gpu_info.setMinimumHeight(60)
        info_card.layout().addWidget(self.gpu_info)

        refresh_btn = QPushButton("Refresh")
        refresh_btn.setObjectName("smallBtn")
        refresh_btn.clicked.connect(self.refresh_gpu)
        info_card.layout().addWidget(refresh_btn)
        layout.addWidget(info_card)

        # Switch card
        switch_card = self._card("Switch Default GPU")
        desc = QLabel("Switch which GPU is used by default for new applications.\n"
                       "Log out and back in for full effect.")
        desc.setStyleSheet(f"color: {LIGHT}; font-size: 12px;")
        desc.setWordWrap(True)
        switch_card.layout().addWidget(desc)

        btn_row = QHBoxLayout()
        int_btn = QPushButton("Use Integrated GPU (Power Saving)")
        int_btn.setObjectName("actionBtn")
        int_btn.clicked.connect(lambda: self.do_switch("integrated"))
        btn_row.addWidget(int_btn)
        disc_btn = QPushButton("Use Discrete GPU (Performance)")
        disc_btn.setObjectName("actionBtn")
        disc_btn.clicked.connect(lambda: self.do_switch("discrete"))
        btn_row.addWidget(disc_btn)
        switch_card.layout().addLayout(btn_row)
        layout.addWidget(switch_card)

        # Launch card
        launch_card = self._card("Launch App on Discrete GPU")
        launch_row = QHBoxLayout()
        self.app_input = QLineEdit()
        self.app_input.setPlaceholderText("Application name or command (e.g. steam)")
        self.app_input.setStyleSheet(f"""
            background: {DARK}; color: {LIGHT}; border: 1px solid rgba(100,255,218,0.3);
            border-radius: 8px; padding: 8px; font-size: 13px;
        """)
        launch_row.addWidget(self.app_input)
        launch_btn = QPushButton("Launch")
        launch_btn.setObjectName("smallBtn")
        launch_btn.clicked.connect(self.do_launch)
        launch_row.addWidget(launch_btn)
        launch_card.layout().addLayout(launch_row)
        layout.addWidget(launch_card)

        # Footer
        footer = QLabel("JULinux — github.com/bfitzgit23/stormos-build-files")
        footer.setStyleSheet(f"color: {BLUE}; font-size: 10px;")
        layout.addWidget(footer)

        self.setStyleSheet(f"""
            QMainWindow {{ background-color: {NAVY}; }}
            #central {{ background-color: {GLASS}; border-radius: 16px;
                         border: 1px solid rgba(100,255,218,0.1); }}
            QLabel {{ color: {LIGHT}; background: transparent; }}
            QPushButton#actionBtn {{
                background: rgba(100,255,218,0.08); color: {LIGHT};
                border: 1px solid rgba(100,255,218,0.2); border-radius: 10px;
                padding: 10px 16px; font-size: 13px;
            }}
            QPushButton#actionBtn:hover {{
                background: rgba(100,255,218,0.15); border-color: {BLUE};
            }}
            QPushButton#smallBtn {{
                background: rgba(30,58,95,0.7); color: {BLUE};
                border: 1px solid rgba(100,255,218,0.3); border-radius: 8px;
                padding: 6px 14px; font-size: 12px;
            }}
            QPushButton#smallBtn:hover {{ background: rgba(30,58,95,1.0); }}
        """)

        self.refresh_gpu()

    def _card(self, title):
        card = QWidget()
        card.setStyleSheet(f"""
            QWidget {{ background-color: {GLASS}; border: 1px solid rgba(100,255,218,0.2);
                        border-radius: 14px; }}
        """)
        lay = QVBoxLayout(card)
        lay.setContentsMargins(14, 10, 14, 14)
        lay.setSpacing(8)
        lbl = QLabel(title)
        lbl.setStyleSheet(f"color: {BLUE}; font-weight: bold; font-size: 14px; "
                          f"background: transparent; border: none;")
        lay.addWidget(lbl)
        return card

    def refresh_gpu(self):
        self.gpu_info.setText("Detecting...")
        self._worker = GPUSwitcher()
        self._worker.finished.connect(self._on_info)
        self._worker.error.connect(lambda e: self.gpu_info.setText(f"Error: {e}"))
        self._worker.start()

    def _on_info(self, info):
        self.gpu_info_text = info
        display = info[:300] + ("..." if len(info) > 300 else "")
        self.gpu_info.setText(display)

    def do_switch(self, gpu_type):
        msg = GPUBackend.switch_gpu(gpu_type)
        QMessageBox.information(self, "GPU Switched",
                                f"{msg}\n\nLog out and back in for full effect.")

    def do_launch(self):
        cmd = self.app_input.text().strip()
        if not cmd:
            QMessageBox.warning(self, "No Command", "Enter an application name or command.")
            return
        if GPUBackend.launch_on_gpu(cmd):
            QMessageBox.information(self, "Launched",
                                    f"Launched on discrete GPU: {cmd}")
        else:
            QMessageBox.critical(self, "Error", f"Failed to launch: {cmd}")


# ── Tray mode ────────────────────────────────────────────────────────────────
class SwitcherooTray(QSystemTrayIcon):
    """System tray applet — used when a tray is available."""

    def __init__(self, parent=None):
        super().__init__(parent)
        icon_path = "/usr/share/icons/julinux/switcheroo.png"
        if not os.path.exists(icon_path):
            icon_path = "/usr/share/pixmaps/julinux.png"
        self.setIcon(QIcon(icon_path))
        self.setToolTip("JULinux GPU Switcher")

        self.menu = QMenu()
        info_act = QAction("GPU Information", self)
        info_act.triggered.connect(self.show_gpu_info)
        self.menu.addAction(info_act)
        self.menu.addSeparator()

        int_act = QAction("Use Integrated GPU", self)
        int_act.triggered.connect(lambda: self.switch_gpu("integrated"))
        self.menu.addAction(int_act)

        disc_act = QAction("Use Discrete GPU", self)
        disc_act.triggered.connect(lambda: self.switch_gpu("discrete"))
        self.menu.addAction(disc_act)
        self.menu.addSeparator()

        launch_act = QAction("Launch App on Discrete GPU", self)
        launch_act.triggered.connect(self.launch_on_discrete)
        self.menu.addAction(launch_act)
        self.menu.addSeparator()

        about_act = QAction("About", self)
        about_act.triggered.connect(self.show_about)
        self.menu.addAction(about_act)

        quit_act = QAction("Quit", self)
        quit_act.triggered.connect(QApplication.quit)
        self.menu.addAction(quit_act)

        self.setContextMenu(self.menu)

        self._worker = GPUSwitcher()
        self._worker.finished.connect(
            lambda info: self.setToolTip(f"JULinux GPU Switcher\n{info[:60]}"))
        self._worker.error.connect(
            lambda err: self.setToolTip(f"JULinux GPU Switcher\nError: {err}"))
        self._worker.start()

    def show_gpu_info(self):
        info = GPUBackend.get_gpu_info()
        QMessageBox.information(self, "GPU Information",
                                "Available GPUs:\n\n" + info)

    def switch_gpu(self, gpu_type):
        msg = GPUBackend.switch_gpu(gpu_type)
        QMessageBox.information(self, "GPU Switched",
                                f"{msg}\n\nLog out and back in for full effect.")

    def launch_on_discrete(self):
        cmd, ok = QInputDialog.getText(self, "Launch on Discrete GPU",
                                       "Enter application name or command:")
        if ok and cmd:
            if GPUBackend.launch_on_gpu(cmd):
                QMessageBox.information(self, "Launched",
                                        f"Launched on discrete GPU: {cmd}")
            else:
                QMessageBox.critical(self, "Error", f"Failed to launch: {cmd}")

    def show_about(self):
        QMessageBox.about(self, "About JULinux GPU Switcher",
                          "<h3>JULinux GPU Switcher</h3>"
                          "<p>System tray applet for GPU switching</p>"
                          "<p>Based on switcheroo-control</p>"
                          "<p>Part of JULinux</p>")


# ── Entry point ──────────────────────────────────────────────────────────────
def main():
    app = QApplication(sys.argv)
    app.setApplicationName("JULinux GPU Switcher")
    app.setStyle("Fusion")

    palette = app.palette()
    palette.setColor(palette.Window,          QColor(NAVY))
    palette.setColor(palette.WindowText,      QColor(LIGHT))
    palette.setColor(palette.Base,            QColor(DARK))
    palette.setColor(palette.Text,            QColor(LIGHT))
    palette.setColor(palette.Button,          QColor("#1a3a5c"))
    palette.setColor(palette.ButtonText,      QColor(LIGHT))
    app.setPalette(palette)

    if QSystemTrayIcon.isSystemTrayAvailable():
        # Tray mode — lives in the notification area
        app.setQuitOnLastWindowClosed(False)
        tray = SwitcherooTray()
        tray.show()
    else:
        # Window mode — XFCE without a tray plugin
        win = SwitcherooWindow()
        win.show()

    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
