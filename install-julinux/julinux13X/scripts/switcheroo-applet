#!/usr/bin/env python3
"""
JULinux Switcheroo-Control Applet
System tray applet for GPU switching using switcheroo-control
"""

import subprocess
import sys
import os

try:
    from PyQt5.QtWidgets import (QApplication, QSystemTrayIcon, QMenu, 
                                  QAction, QMessageBox, QWidget)
    from PyQt5.QtGui import QIcon
    from PyQt5.QtCore import QThread, pyqtSignal
except ImportError:
    print("Error: python3-pyqt5 not installed")
    print("Install with: sudo apt install python3-pyqt5")
    sys.exit(1)

class GPUSwitcher(QThread):
    """Background thread for GPU switching operations"""
    finished = pyqtSignal(str)
    error = pyqtSignal(str)
    
    def run(self):
        try:
            # Check if switcheroo-control is available
            result = subprocess.run(['switcherooctl', 'list'], 
                                  capture_output=True, text=True, timeout=10)
            if result.returncode == 0:
                self.finished.emit(result.stdout)
            else:
                self.error.emit("switcherooctl not available")
        except FileNotFoundError:
            self.error.emit("switcheroo-control not installed")
        except subprocess.TimeoutExpired:
            self.error.emit("switcherooctl timed out")
        except Exception as e:
            self.error.emit(str(e))

class JULinuxSwitcherooApplet(QSystemTrayIcon):
    """System tray applet for GPU switching"""
    
    def __init__(self, parent=None):
        super().__init__(parent)
        
        # Set icon
        icon_path = "/usr/share/icons/julinux/switcheroo.png"
        if not os.path.exists(icon_path):
            icon_path = "/usr/share/pixmaps/julinux.png"
        self.setIcon(QIcon(icon_path))
        
        self.setToolTip("JULinux GPU Switcher")
        
        # Create menu
        self.menu = QMenu()
        
        # GPU info action
        info_action = QAction("GPU Information", self)
        info_action.triggered.connect(self.show_gpu_info)
        self.menu.addAction(info_action)
        
        self.menu.addSeparator()
        
        # Switch to integrated GPU
        integrated_action = QAction("Use Integrated GPU", self)
        integrated_action.triggered.connect(lambda: self.switch_gpu("integrated"))
        self.menu.addAction(integrated_action)
        
        # Switch to discrete GPU
        discrete_action = QAction("Use Discrete GPU", self)
        discrete_action.triggered.connect(lambda: self.switch_gpu("discrete"))
        self.menu.addAction(discrete_action)
        
        self.menu.addSeparator()
        
        # Launch app on discrete GPU
        launch_discrete_action = QAction("Launch App on Discrete GPU", self)
        launch_discrete_action.triggered.connect(self.launch_on_discrete)
        self.menu.addAction(launch_discrete_action)
        
        self.menu.addSeparator()
        
        # About
        about_action = QAction("About JULinux GPU Switcher", self)
        about_action.triggered.connect(self.show_about)
        self.menu.addAction(about_action)
        
        # Quit
        quit_action = QAction("Quit", self)
        quit_action.triggered.connect(QApplication.quit)
        self.menu.addAction(quit_action)
        
        self.setContextMenu(self.menu)
        
        # Start GPU detection thread
        self.gpu_thread = GPUSwitcher()
        self.gpu_thread.finished.connect(self.on_gpu_info)
        self.gpu_thread.error.connect(self.on_gpu_error)
        self.gpu_thread.start()
    
    def show_gpu_info(self):
        """Show GPU information dialog"""
        try:
            result = subprocess.run(['switcherooctl', 'list'], 
                                  capture_output=True, text=True, timeout=10)
            if result.returncode == 0:
                QMessageBox.information(self, "GPU Information", 
                    "Available GPUs:\n\n" + result.stdout)
            else:
                QMessageBox.warning(self, "GPU Information", 
                    "Could not retrieve GPU information.\n"
                    "Make sure switcheroo-control is installed and running.")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Failed to get GPU info:\n{str(e)}")
    
    def switch_gpu(self, gpu_type):
        """Switch to specified GPU type"""
        try:
            if gpu_type == "integrated":
                # Set environment for integrated GPU
                env_var = "DRI_PRIME=0"
                msg = "Switched to integrated GPU"
            else:
                # Set environment for discrete GPU
                env_var = "DRI_PRIME=1"
                msg = "Switched to discrete GPU"
            
            # Write to profile
            profile_path = os.path.expanduser("~/.profile")
            with open(profile_path, 'a') as f:
                f.write(f"\n# JULinux GPU Switch\nexport {env_var}\n")
            
            QMessageBox.information(self, "GPU Switched", 
                f"{msg}\n\nNew applications will use this GPU.\n"
                "Log out and back in for full effect.")
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Failed to switch GPU:\n{str(e)}")
    
    def launch_on_discrete(self):
        """Launch an application on the discrete GPU"""
        from PyQt5.QtWidgets import QInputDialog
        
        app_name, ok = QInputDialog.getText(self, "Launch on Discrete GPU", 
            "Enter application name or command:")
        
        if ok and app_name:
            try:
                subprocess.Popen(['switcherooctl', 'launch', app_name],
                               env={**os.environ, 'DRI_PRIME': '1'})
            except Exception as e:
                QMessageBox.critical(self, "Error", 
                    f"Failed to launch application:\n{str(e)}")
    
    def show_about(self):
        """Show about dialog"""
        QMessageBox.about(self, "About JULinux GPU Switcher",
            "<h3>JULinux GPU Switcher</h3>"
            "<p>System tray applet for GPU switching</p>"
            "<p>Based on switcheroo-control</p>"
            "<p>Part of JULinux Linux</p>"
            "<p>GitHub: https://github.com/bfitzgit23/stormos-build-files</p>")
    
    def on_gpu_info(self, info):
        """Handle GPU info received"""
        self.setToolTip(f"JULinux GPU Switcher\n{info[:50]}...")
    
    def on_gpu_error(self, error):
        """Handle GPU error"""
        self.setToolTip(f"JULinux GPU Switcher\nError: {error}")

def main():
    app = QApplication(sys.argv)
    app.setApplicationName("JULinux GPU Switcher")
    app.setQuitOnLastWindowClosed(False)
    
    # Check if system tray is available
    if not QSystemTrayIcon.isSystemTrayAvailable():
        QMessageBox.critical(None, "System Tray", 
            "System tray is not available on this system.")
        sys.exit(1)
    
    switcher = JULinuxSwitcherooApplet()
    switcher.show()
    
    sys.exit(app.exec_())

if __name__ == "__main__":
    main()
