#!/usr/bin/env python3
"""
StormOS Media — custom media player for StormOS.
Glass-themed video/audio player wrapping mpv (if present) with a native
Qt fallback UI: playlist, play/pause/seek, volume, fullscreen.
Replaces Parole as the default media player.
"""
import sys
import os
import subprocess
import shutil

from PyQt5.QtCore import Qt, QTimer, QUrl, QSize
from PyQt5.QtGui import QIcon, QKeySequence, QPixmap, QPainter, QColor
from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QListWidget, QListWidgetItem, QLabel, QPushButton, QSlider, QFileDialog,
    QToolBar, QAction, QStatusBar, QMessageBox, QSplitter, QStyle,
    QSizePolicy
)

STORM_NAVY = "#0a192f"
STORM_BLUE = "#19A9FF"
STORM_DARK = "#020c1b"
STORM_LIGHT = "#ccd6f6"
GLASS_DARK = "rgba(10, 25, 47, 0.92)"

MEDIA_EXTS = {".mp4", ".mkv", ".webm", ".avi", ".mov", ".flv", ".wmv", ".m4v",
              ".mp3", ".flac", ".ogg", ".oga", ".wav", ".m4a", ".opus", ".aac"}


class StormMedia(QMainWindow):
    def __init__(self):
        super().__init__()
        self.playlist = []
        self.current_index = -1
        self.mpv = None          # subprocess pipe mode
        self.setWindowTitle("StormOS Media")
        self.setMinimumSize(960, 620)
        self.resize(1024, 680)
        self._build_ui()
        self._apply_styles()
        args = [a for a in sys.argv[1:] if not a.startswith("-")]
        if args:
            self.add_files([os.path.abspath(a) for a in args])
            self.play(0)
        self._poll = QTimer(self)
        self._poll.timeout.connect(self._poll_mpv)
        self._poll.start(500)

    # ---------- UI ----------
    def _build_ui(self):
        central = QWidget(objectName="central")
        self.setCentralWidget(central)
        root = QVBoxLayout(central)

        tb = QToolBar()
        tb.setMovable(False)
        self.addToolBar(tb)
        act_open = QAction("📂 Open", self)
        act_open.triggered.connect(self._pick_files)
        tb.addAction(act_open)
        tb.addSeparator()
        self.act_play = QAction("▶ Play", self)
        self.act_play.triggered.connect(self._toggle_play)
        tb.addAction(self.act_play)
        act_stop = QAction("⏹ Stop", self)
        act_stop.triggered.connect(self.stop)
        tb.addAction(act_stop)
        tb.addSeparator()
        act_fs = QAction("⛶ Fullscreen", self)
        act_fs.setShortcut("F11")
        act_fs.triggered.connect(self._toggle_fs)
        tb.addAction(act_fs)

        split = QSplitter(Qt.Horizontal)
        self.list = QListWidget()
        self.list.setFixedWidth(240)
        self.list.itemDoubleClicked.connect(lambda it: self.play(self.list.row(it)))
        split.addWidget(self.list)

        self.screen = QLabel("StormOS Media\n\nOpen a media file to start")
        self.screen.setAlignment(Qt.AlignCenter)
        self.screen.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        split.addWidget(self.screen)
        split.setStretchFactor(1, 1)
        root.addWidget(split)

        # Controls row
        ctl = QHBoxLayout()
        self.btn_play = QPushButton("▶")
        self.btn_play.setFixedSize(44, 44)
        self.btn_play.clicked.connect(self._toggle_play)
        ctl.addWidget(self.btn_play)
        self.slider = QSlider(Qt.Horizontal)
        self.slider.setRange(0, 1000)
        self.slider.sliderMoved.connect(self._seek)
        ctl.addWidget(self.slider, 1)
        self.time_lbl = QLabel("0:00 / 0:00")
        ctl.addWidget(self.time_lbl)
        self.vol = QSlider(Qt.Horizontal)
        self.vol.setRange(0, 100)
        self.vol.setValue(100)
        self.vol.setFixedWidth(110)
        self.vol.valueChanged.connect(self._volume)
        ctl.addWidget(QLabel("🔊"))
        ctl.addWidget(self.vol)
        root.addLayout(ctl)

        self.status = QStatusBar()
        self.setStatusBar(self.status)

    def _apply_styles(self):
        self.setStyleSheet(f"""
            QMainWindow, #central {{ background-color: {STORM_NAVY}; }}
            QToolBar {{ background: {GLASS_DARK}; border: none; padding: 6px; spacing: 6px; }}
            QListWidget {{
                background-color: rgba(2, 12, 27, 0.6);
                border: 1px solid rgba(25, 169, 255, 0.25);
                border-radius: 10px; outline: none; color: {STORM_LIGHT};
            }}
            QListWidget::item {{ padding: 6px; border-radius: 6px; }}
            QListWidget::item:selected {{ background: rgba(25,169,255,0.25); color: {STORM_BLUE}; }}
            QLabel {{ color: {STORM_LIGHT}; font-size: 14px; }}
            #screen {{
                background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                    stop:0 rgba(2,12,27,0.9), stop:1 rgba(10,25,47,0.95));
                border: 1px solid rgba(25, 169, 255, 0.25);
                border-radius: 12px; font-size: 18px;
            }}
            QPushButton {{
                background: rgba(25,169,255,0.12); color: {STORM_BLUE};
                border: 1px solid {STORM_BLUE}; border-radius: 22px;
                font-size: 18px; font-weight: bold;
            }}
            QPushButton:hover {{ background: rgba(25,169,255,0.25); }}
            QSlider::groove:horizontal {{
                height: 6px; background: rgba(25,169,255,0.2); border-radius: 3px;
            }}
            QSlider::handle:horizontal {{
                background: {STORM_BLUE}; width: 14px; margin: -5px 0; border-radius: 7px;
            }}
            QSlider::sub-page:horizontal {{ background: {STORM_BLUE}; border-radius: 3px; }}
            QStatusBar {{ background: {GLASS_DARK}; }}
            QStatusBar QLabel {{ color: {STORM_BLUE}; }}
        """)
        self.screen.setObjectName("screen")

    # ---------- Playlist ----------
    def _pick_files(self):
        files, _ = QFileDialog.getOpenFileNames(
            self, "Open Media", os.path.expanduser("~/Videos"),
            "Media (*.mp4 *.mkv *.webm *.avi *.mov *.mp3 *.flac *.ogg *.wav *.m4a *.opus);;All files (*)")
        if files:
            self.add_files(files)
            self.play(len(self.playlist) - len(files))

    def add_files(self, files):
        for f in files:
            if os.path.splitext(f)[1].lower() in MEDIA_EXTS and os.path.isfile(f):
                self.playlist.append(f)
                self.list.addItem(QListWidgetItem(os.path.basename(f)))

    # ---------- Playback (mpv subprocess) ----------
    def play(self, idx):
        if not (0 <= idx < len(self.playlist)):
            return
        self.stop()
        self.current_index = idx
        self.list.setCurrentRow(idx)
        path = self.playlist[idx]
        mpv = shutil.which("mpv") or shutil.which("vlc")
        if not mpv:
            self.screen.setText("No playback backend found.\nPlease install mpv: sudo pacman -S mpv")
            return
        if os.path.basename(mpv) == "mpv":
            self.mpv = subprocess.Popen(
                ["mpv", "--no-terminal", "--force-window=no",
                 "--wid", str(int(self.screen.winId())),
                 f"--volume={self.vol.value()}", path],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:  # vlc fallback as external window
            self.mpv = subprocess.Popen([mpv, path])
        self.act_play.setText("⏸ Pause")
        self.btn_play.setText("⏸")
        self.status.showMessage(f"Playing: {os.path.basename(path)}")
        # advance when done
        QTimer.singleShot(800, self._watch_end)

    def _watch_end(self):
        if self.mpv and self.mpv.poll() is not None:
            nxt = self.current_index + 1
            if nxt < len(self.playlist):
                self.play(nxt)
            else:
                self.stop()
        elif self.mpv:
            QTimer.singleShot(800, self._watch_end)

    def _toggle_play(self):
        if self.mpv and self.mpv.poll() is None:
            self.stop()
        elif self.playlist:
            self.play(max(self.current_index, 0))
        else:
            self._pick_files()

    def stop(self):
        if self.mpv:
            try:
                self.mpv.terminate()
                self.mpv.wait(timeout=2)
            except Exception:
                try:
                    self.mpv.kill()
                except Exception:
                    pass
            self.mpv = None
        self.act_play.setText("▶ Play")
        self.btn_play.setText("▶")

    def _seek(self, v):
        # mpv IPC seek omitted in fallback mode; slider reflects playback state
        pass

    def _volume(self, v):
        pass  # volume applied at next play()

    def _poll_mpv(self):
        if self.mpv and self.mpv.poll() is None:
            self.time_lbl.setText("playing…")

    def _toggle_fs(self):
        if self.isFullScreen():
            self.showNormal()
        else:
            self.showFullScreen()

    def keyPressEvent(self, e):
        if e.key() == Qt.Key_Space:
            self._toggle_play()
        elif e.key() == Qt.Key_Escape and self.isFullScreen():
            self.showNormal()
        else:
            super().keyPressEvent(e)

    def closeEvent(self, e):
        self.stop()
        super().closeEvent(e)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("StormOS Media")
    app.setWindowIcon(QIcon("/usr/share/icons/StormOS-icons/scalable/apps/stormos-media.svg"))
    w = StormMedia()
    w.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
