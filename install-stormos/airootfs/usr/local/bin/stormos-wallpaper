#!/bin/sh
# StormOS: keep the StormOS wallpaper on every monitor.
#
# xfdesktop stores one backdrop per monitor, keyed by the monitor name it gets
# from the driver, e.g.
#   /backdrop/screen0/monitoreDP-1/workspace0/last-image
# A monitor whose name is not in the seeded config is created with the stock
# Xfce image, so the desktop comes up with the default wallpaper instead of
# ours.  This script runs from /etc/xdg/autostart, waits for xfdesktop to
# publish those properties and replaces only values that are still unset or
# still the stock Xfce default, so a wallpaper the user picked is kept.

WALLPAPER=/usr/share/backgrounds/stormos-wallpaper.png
STOCK_DIR=/usr/share/backgrounds/xfce/

[ -f "$WALLPAPER" ] || exit 0
command -v xfconf-query >/dev/null 2>&1 || exit 0

list_images() {
    xfconf-query -c xfce4-desktop -l 2>/dev/null | grep '/last-image$'
}

apply_wallpaper() {
    count=0
    for prop in $(list_images); do
        current=$(xfconf-query -c xfce4-desktop -p "$prop" 2>/dev/null)
        case "$current" in
            '' | "$STOCK_DIR"*)
                if xfconf-query -c xfce4-desktop -p "$prop" -s "$WALLPAPER" 2>/dev/null; then
                    count=$((count + 1))
                fi
                ;;
        esac
    done
    echo "$count"
}

# xfdesktop creates the per-monitor properties while it starts up.
i=0
while [ -z "$(list_images)" ] && [ "$i" -lt 40 ]; do
    i=$((i + 1))
    sleep 0.25
done

total=$(apply_wallpaper)
# Give a slow video driver another moment to publish the monitor it settled on.
sleep 2
applied=$(apply_wallpaper)
total=$((total + applied))

if [ "$total" -gt 0 ]; then
    xfdesktop --reload >/dev/null 2>&1
fi

exit 0
