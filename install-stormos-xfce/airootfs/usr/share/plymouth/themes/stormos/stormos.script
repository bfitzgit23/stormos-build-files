# StormOS Plymouth Boot Splash
# Lightning bolt branding with animated progress bar

# ─── Colors ──────────────────────────────────────────────────────────────────
BG_COLOR = (0.04, 0.086, 0.157);        # #0A1628 dark navy
BOLT_COLOR = (0.098, 0.663, 1.0);       # #19A9FF electric blue
BOLT_GLOW = (0.098, 0.663, 1.0, 0.3);   # glow alpha
BAR_BG = (0.067, 0.102, 0.165, 0.6);    # progress bar track
BAR_FG = (0.098, 0.663, 1.0);           # progress bar fill
TEXT_COLOR = (0.91, 0.949, 1.0);        # #E8F2FF light text

# ─── Window setup ────────────────────────────────────────────────────────────
window.background_color = BG_COLOR;

# ─── Logo (lightning bolt PNG) ───────────────────────────────────────────────
logo.image = "bolt.png";
logo.position = (0.5, 0.35);
logo.anchor = (0.5, 0.5);
logo.scaling = 0.15;

# ─── Brand text ──────────────────────────────────────────────────────────────
brand.text = "StormOS";
brand.font = "Inter Bold 32";
brand.color = TEXT_COLOR;
brand.position = (0.5, 0.55);
brand.anchor = (0.5, 0.5);

# ─── Progress bar ────────────────────────────────────────────────────────────
bar.size = (0.35, 0.004);
bar.position = (0.5, 0.65);
bar.anchor = (0.5, 0.5);
bar.background_color = BAR_BG;
bar.foreground_color = BAR_FG;
bar.border_color = BAR_FG;

# ─── Status text ─────────────────────────────────────────────────────────────
status.text = "";
status.font = "Inter 12";
status.color = (0.6, 0.7, 0.8);
status.position = (0.5, 0.72);
status.anchor = (0.5, 0.5);

# ─── Spinner (pulsing glow around bolt) ──────────────────────────────────────
spinner.image = "glow.png";
spinner.position = (0.5, 0.35);
spinner.anchor = (0.5, 0.5);
spinner.scaling = 0.2;

# ─── Boot messages ───────────────────────────────────────────────────────────
boot_message.text = "";
boot_message.font = "Inter 11";
boot_message.color = (0.5, 0.6, 0.7);
boot_message.position = (0.5, 0.80);
boot_message.anchor = (0.5, 0.5);

# ═══════════════════════════════════════════════════════════════════════════════
# Animation callbacks
# ═══════════════════════════════════════════════════════════════════════════════

# Pulse animation for the glow
pulse_progress = 0.0;
pulse_speed = 2.0;

fun pulse_callback () {
    global pulse_progress;
    pulse_progress = pulse_progress + (1.0 / 60.0) * pulse_speed;
    if (pulse_progress > 3.14159):
        pulse_progress = pulse_progress - 6.28318;
    end;

    # Pulse the glow opacity between 0.1 and 0.5
    glow_alpha = 0.3 + 0.2 * Math.Cos(pulse_progress);
    spinner.opacity = glow_alpha;

    # Pulse the logo scaling slightly
    logo.scaling = 0.15 + 0.005 * Math.Cos(pulse_progress * 1.5);

    # Keep animating
    Plymouth.SetTimerFunction(pulse_callback, 1.0 / 60.0);
}

# Start pulse on display
fun on_display_ready () {
    Plymouth.SetTimerFunction(pulse_callback, 1.0 / 60.0);
}

# ═══════════════════════════════════════════════════════════════════════════════
# Progress updates
# ═══════════════════════════════════════════════════════════════════════════════

# Normal boot progress (0.0 to 1.0)
fun update_progress (progress) {
    bar.value = progress;

    # Update status text based on progress
    if (progress < 0.1):
        status.text = "Initializing...";
    elif (progress < 0.3):
        status.text = "Loading kernel modules...";
    elif (progress < 0.5):
        status.text = "Starting services...";
    elif (progress < 0.7):
        status.text = "Mounting filesystems...";
    elif (progress < 0.9):
        status.text = "Starting display manager...";
    else:
        status.text = "Almost ready...";
    end;
}

# Boot finished — fade out
fun on_boot_progress (progress) {
    update_progress(progress);

    if (progress >= 1.0):
        # Quick fade out
        logo.opacity = 0.0;
        brand.opacity = 0.0;
        bar.opacity = 0.0;
        status.opacity = 0.0;
        spinner.opacity = 0.0;
        boot_message.opacity = 0.0;
    end;
}

# Message during boot (e.g. "fsck", "resume")
fun on_boot_message (message) {
    if (message != ""):
        boot_message.text = message;
    end;
}

# Quit — clean up
fun on_quit () {
    logo.opacity = 0.0;
    brand.opacity = 0.0;
    bar.opacity = 0.0;
    status.opacity = 0.0;
    spinner.opacity = 0.0;
    boot_message.opacity = 0.0;
}

# Password prompt (for encrypted disks)
fun on_password_prompt (prompt) {
    status.text = prompt;
    bar.opacity = 0.0;
    spinner.opacity = 0.0;
}

fun on_password_response () {
    bar.opacity = 1.0;
    spinner.opacity = 1.0;
}
