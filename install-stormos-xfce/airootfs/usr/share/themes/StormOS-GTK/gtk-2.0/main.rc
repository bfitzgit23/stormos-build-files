# StormOS GTK2 Theme — Main Rules
# Based on Murrine engine with StormOS colors

style "default" {
    xthickness = 1
    ythickness = 1

    GtkWidget::focus-line-width = 1
    GtkWidget::focus-padding = 0
    GtkWidget::interior-focus = 1
    GtkWidget::link-color = @link_color
    GtkWidget::visited-link-color = @visited_link_color

    GtkButton::child-displacement-x = 1
    GtkButton::child-displacement-y = 1
    GtkButton::default-border = { 0, 0, 0, 0 }
    GtkButton::default-outside-border = { 0, 0, 0, 0 }
    GtkButton::image-spacing = 4

    GtkCheckButton::indicator-size = 16
    GtkRadioButton::indicator-size = 16

    GtkExpander::expander-size = 16

    GtkMenuBar::internal-padding = 0

    GtkMenu::horizontal-padding = 0
    GtkMenu::vertical-padding = 4

    GtkMenuItem::arrow-scaling = 0.5

    GtkNotebook::tab-overlap = -1

    GtkPaned::handle-size = 6

    GtkRange::slider-width = 14
    GtkRange::stepper-size = 14
    GtkRange::trough-border = 0
    GtkRange::trough-under-steppers = 1

    GtkScale::slider-length = 20
    GtkScale::slider-width = 20
    GtkScale::trough-side-details = 1

    GtkScrollbar::has-backward-stepper = 0
    GtkScrollbar::has-forward-stepper = 0
    GtkScrollbar::min-slider-length = 40
    GtkScrollbar::slider-width = 10

    GtkScrolledWindow::scrollbar-spacing = 0
    GtkScrolledWindow::scrollbars-within-bevel = 1

    GtkToolbar::internal-padding = 4

    # Murrine engine settings
    Murrine/animation = TRUE
    Murrine/arrowstyle = 2
    Murrine/boolean_horizontal = FALSE
    Murrine/border_shades = { 0.6, 0.6 }
    Murrine/combooboxstyle = 0
    Murrine/default_button_color = @selected_bg_color
    Murrine/derive_highlight_color = FALSE
    Murrine/focus_color = @selected_bg_color
    Murrine/focus_style = 2
    Murrine/glow_shade = 1.0
    Murrine/glowstyle = 0
    Murrine/glow_shade = 1.0
    Murrine/highlight_shade = 1.1
    Murrine/lightborder_shade = 1.0
    Murrine/lightborderstyle = 0
    Murrine/listviewheaderstyle = 0
    Murrine/listviewstyle = 2
    Murrine/menubaritemstyle = 0
    Murrine/menubarstyle = 0
    Murrine/menuitemstyle = 0
    Murrine/menustyle = 0
    Murrine/progressbarstyle = 0
    Murrine/reliefstyle = 2
    Murrine/rgba = FALSE
    Murrine/roundness = 4
    Murrine/scrollbarstyle = 0
    Murrine/separatorstyle = 1
    Murrine/shadow_shades = { 0.5, 0.0 }
    Murrine/sliderstyle = 0
    Murrine/stepperstyle = 1
    Murrine/textstyle = 0
    Murrine/tint_shade = 0.0
    Murrine/toolbarstyle = 2
    Murrine/trough_shades = { 0.85, 0.9 }

    engine "murrine" {
        contrast = 0.4
        colorize_scrollbar = FALSE
        default_color_shade = 1.0
        shadow_shades = { 0.5, 0.0 }
        glow_shades = { 0.0, 0.0 }
        highlight_shades = { 1.0, 1.0 }
        border_shades = { 0.5, 0.5 }
        trough_shades = { 0.8, 0.8 }
    }
}

class "GtkWidget" style "default"

style "button_text" = "default" {
    text[NORMAL] = @fg_color
    text[PRELIGHT] = @fg_color
    text[SELECTED] = @selected_fg_color
    text[INSENSITIVE] = mix(0.4, @fg_color, @bg_color)
}

style "base" = "default" {
    bg[NORMAL] = @base_color
    bg[PRELIGHT] = shade(1.04, @base_color)
    bg[SELECTED] = @selected_bg_color
    bg[INSENSITIVE] = @bg_color

    fg[NORMAL] = @fg_color
    fg[PRELIGHT] = @fg_color
    fg[SELECTED] = @selected_fg_color
    fg[INSENSITIVE] = mix(0.5, @fg_color, @bg_color)

    text[NORMAL] = @text_color
    text[PRELIGHT] = @text_color
    text[SELECTED] = @selected_fg_color
    text[INSENSITIVE] = mix(0.5, @fg_color, @bg_color)
}
