{
  "version": "2.6",
  "profile": "minimal",
  "script": "guided",
  "bootloader": "systemd-boot",
  "target": null,
  "disk_encryption": false,
  "swap": true,
  "swap_size": "4G",
  "hostname": "stomros",
  "locale": "en_US.UTF-8",
  "keymap": "us",
  "timezone": "UTC",
  "root_password": null,
  "users": [
    {
      "username": "storm",
      "password": null,
      "sudo": true,
      "groups": [
        "wheel",
        "video",
        "audio",
        "storage",
        "power",
        "network"
      ]
    }
  ],
  "packages": [
    "base",
    "linux",
    "linux-firmware",
    "linux-headers",
    "sudo",
    "networkmanager",
    "polkit",
    "polkit-gnome",
    "vim",
    "git",
    "curl",
    "wget",
    "htop",
    "btop",
    "unzip",
    "zip",
    "pipewire",
    "pipewire-pulse",
    "pipewire-alsa",
    "wireplumber",
    "brightnessctl",
    "power-profiles-daemon",
    "cpupower",
    "pciutils",
    "envycontrol",
    "lightdm",
    "lightdm-slick-greeter",
    "plymouth",
    "xfwm4",
    "xfce4-settings",
    "xfconf",
    "xfce4-notifyd",
    "electron",
    "python",
    "firefox",
    "thunar",
    "gvfs",
    "gvfs-mtp",
    "gvfs-gphoto2",
    "file-roller",
    "xarchiver",
    "code",
    "noto-fonts",
    "noto-fonts-emoji",
    "noto-fonts-cjk",
    "ttf-jetbrains-mono",
    "ttf-firacode-nerd",
    "inter-font"
  ],
  "services": [
    "NetworkManager",
    "lightdm",
    "systemd-timesyncd",
    "pipewire",
    "pipewire-pulse"
  ],
  "kernels": [
    "linux"
  ],
  "profile_def": {
    "name": "StomrOS Aurora",
    "description": "Vibe-coded desktop over minimal Xfce substrate",
    "packages": [
      "base",
      "linux",
      "linux-firmware",
      "linux-headers",
      "sudo",
      "networkmanager",
      "polkit",
      "polkit-gnome",
      "vim",
      "git",
      "curl",
      "wget",
      "htop",
      "btop",
      "unzip",
      "zip",
      "pipewire",
      "pipewire-pulse",
      "pipewire-alsa",
      "wireplumber",
      "brightnessctl",
      "power-profiles-daemon",
      "cpupower",
      "pciutils",
      "envycontrol",
      "lightdm",
      "lightdm-slick-greeter",
      "plymouth",
      "xfwm4",
      "xfce4-settings",
      "xfconf",
      "xfce4-notifyd",
      "electron",
      "python",
      "firefox",
      "thunar",
      "gvfs",
      "gvfs-mtp",
      "gvfs-gphoto2",
      "file-roller",
      "xarchiver",
      "code",
      "noto-fonts",
      "noto-fonts-emoji",
      "noto-fonts-cjk",
      "ttf-jetbrains-mono",
      "ttf-firacode-nerd",
      "inter-font"
    ]
  },
  "post_install": [
    "sed -i 's/^#autologin-user=.*/autologin-user=storm/' /etc/lightdm/lightdm.conf",
    "sed -i 's/^#autologin-session=.*/autologin-session=storm/' /etc/lightdm/lightdm.conf",
    "sed -i 's/^#greeter-session=.*/greeter-session=lightdm-slick-greeter/' /etc/lightdm/lightdm.conf",
    "mkdir -p /etc/lightdm",
    "cat > /etc/lightdm/slick-greeter.conf <<'EOF'\n[Greeter]\nbackground=/usr/share/backgrounds/stormos-grub.png\ntheme-name=Storm-Dark\nicon-theme-name=Papirus-Dark\nfont-name=Inter 10\nshow-indicators=~session;~power\nshow-clock=true\nclock-format=%H:%M\nEOF",
    "mkdir -p /usr/share/plymouth/themes/stormos",
    "cat > /usr/share/plymouth/themes/stormos/stormos.plymouth <<'EOF'\n[Plymouth Theme]\nName=StomrOS Aurora\nDescription=Vibe-coded boot splash\nModuleName=script\n[script]\nImageDir=/usr/share/plymouth/themes/stormos\nScriptFile=/usr/share/plymouth/themes/stormos/stormos.script\nEOF",
    "pacman -U --noconfirm /tmp/stormui-git-*.pkg.tar.zst 2>/dev/null || true",
    "bash /usr/lib/stormui/arch/stage3-arch.sh --apply --install --autologin storm 2>/dev/null || true",
    "systemctl set-default graphical.target",
    "sudo -u storm systemctl --user enable stormd.service 2>/dev/null || true",
    "pacman -Sc --noconfirm",
    "rm -rf /tmp/* /var/tmp/*"
  ],
  "extra_repos": [],
  "extra_packages": []
}