#!/usr/bin/env bash
# stormos-desktop — StormOS session entry point.
#
# Uses startxfce4 as the base session (xfsettingsd, xfconfd, xfwm4,
# xfce4-panel, xfdesktop — all properly wired). Then optionally launches
# the StormOS React shell as a fullscreen Electron overlay on top.
#
# Session startup:
#   1. startxfce4 (full XFCE session, non-blocking background)
#   2. Optional Electron overlay (if available)
#   3. Session stays alive as long as XFCE is running

set -uo pipefail

LOG="$HOME/.stormos-desktop.log"
log() { echo "[$(date '+%H:%M:%S')] $*" >> "$LOG"; }

> "$LOG"
log "=== stormos-desktop starting (pid $$) ==="
log "HOME=$HOME USER=$(whoami) DISPLAY=${DISPLAY:-unset}"

PROJECT_DIR="${STORMOS_DESKTOP_DIR:-/usr/share/stormos-shell}"

export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-XFCE}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-stormos}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}"

xset s off -dpms 2>/dev/null || true
xset s noblank 2>/dev/null || true

cleanup() {
    log "=== Cleaning up ==="
    [ -n "${ELECTRON_PID:-}" ] && kill "$ELECTRON_PID" 2>/dev/null
    [ -n "${BRIDGE_PID:-}" ] && kill "$BRIDGE_PID" 2>/dev/null
    wait 2>/dev/null
}
trap cleanup EXIT INT TERM

# --- 1. Start the full XFCE session in the background ---
log "Starting XFCE session via startxfce4..."
startxfce4 &
XFCE_PID=$!
log "XFCE session PID=$XFCE_PID"
sleep 3

if ! kill -0 "$XFCE_PID" 2>/dev/null; then
    log "ERROR: XFCE session failed to start!"
    exit 1
fi
log "XFCE session is running"

# --- 2. Compositor (optional) ---
if command -v picom >/dev/null 2>&1; then
    if ! pgrep -x picom >/dev/null 2>&1; then
        log "Starting picom..."
        picom --daemon 2>>"$LOG" &
        log "picom PID=$!"
        sleep 0.3
    fi
fi

# --- 3. Bridge (background, optional) ---
BRIDGE_PID=""
if [ -f "$PROJECT_DIR/native/stormos-bridge.py" ]; then
    log "Starting bridge..."
    python3 "$PROJECT_DIR/native/stormos-bridge.py" >>"$HOME/.stormos-bridge.log" 2>&1 &
    BRIDGE_PID=$!
    log "Bridge PID=$BRIDGE_PID"
    for i in $(seq 1 15); do
        curl -sf "http://127.0.0.1:${STORMOS_BRIDGE_PORT:-47821}/api/health" >/dev/null 2>&1 && break
        sleep 0.3
    done
    log "Bridge check done"
fi

# --- 4. Electron shell (overlay, optional) ---
ELECTRON_PID=""
ELECTRON_BIN=""
for candidate in /usr/bin/electron /usr/lib/electron/electron /usr/local/bin/electron; do
    [ -x "$candidate" ] && ELECTRON_BIN="$candidate" && break
done
[ -z "$ELECTRON_BIN" ] && ELECTRON_BIN="$(command -v electron 2>/dev/null)"

if [ -n "$ELECTRON_BIN" ] && [ -d "$PROJECT_DIR/dist" ]; then
    log "Launching Electron at $ELECTRON_BIN (dir=$PROJECT_DIR)..."
    "$ELECTRON_BIN" "$PROJECT_DIR" --no-sandbox >>"$HOME/.stormos-electron.log" 2>&1 &
    ELECTRON_PID=$!
    log "Electron PID=$ELECTRON_PID"
    sleep 2
    if ! kill -0 "$ELECTRON_PID" 2>/dev/null; then
        log "WARNING: Electron died — running XFCE-only mode"
        ELECTRON_PID=""
    else
        log "Electron is running"
    fi
else
    log "No Electron available — running XFCE-only mode"
fi

# --- 5. Keep session alive ---
log "Waiting on XFCE session..."
wait "$XFCE_PID" 2>/dev/null
log "=== Session ended (code=$?) ==="
