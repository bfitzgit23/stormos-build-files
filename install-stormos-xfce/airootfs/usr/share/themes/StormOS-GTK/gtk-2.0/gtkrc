# StormOS-GTK — Arc-BLACK-ICE base with StormOS blue accent colors
# GTK2 theme: includes Arc-BLACK-ICE's gtkrc, overrides color scheme

# StormOS blue accent color scheme
gtk-color-scheme = "base_color: #020c1b"
gtk-color-scheme = "text_color: #E8F2FF"
gtk-color-scheme = "bg_color: #0A1628"
gtk-color-scheme = "fg_color: #E8F2FF"
gtk-color-scheme = "tooltip_bg_color: #19A9FF"
gtk-color-scheme = "tooltip_fg_color: #0A1628"
gtk-color-scheme = "selected_bg_color: #19A9FF"
gtk-color-scheme = "selected_fg_color: #0A1628"
gtk-color-scheme = "insensitive_bg_color: #0D1A2E"
gtk-color-scheme = "insensitive_fg_color: #4B5563"
gtk-color-scheme = "notebook_bg: #0A1628"
gtk-color-scheme = "dark_sidebar_bg: #0A1628"
gtk-color-scheme = "link_color: #19A9FF"
gtk-color-scheme = "menu_bg: #0A1628"

gtk-icon-sizes = "gtk-button=16,16"
gtk-auto-mnemonics = 1
gtk-primary-button-warps-slider = 1

# Include Arc-BLACK-ICE's base rendering (engine rules, widget styles)
# The color-scheme above overrides the colors, everything else stays Arc-BLACK-ICE
include "/usr/share/themes/Arc-BLACK-ICE/gtk-2.0/gtkrc"
