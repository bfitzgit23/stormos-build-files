#!/usr/bin/env bash
# stormos-desktop — StormOS session entry point.
#
# Sets up the StormOS environment, starts optional services in the
# background, then execs startxfce4 as the session leader.
#
# The Electron React shell overlay is started via an xfce autostart
# entry (stormos-electron-overlay.desktop) — not by this script.

set -uo pipefail

LOG="$HOME/.stormos-desktop.log"
log() { echo "[$(date '+%H:%M:%S')] $*" >> "$LOG"; }

> "$LOG"
log "=== stormos-desktop starting (pid $$) ==="
log "HOME=$HOME USER=$(whoami) DISPLAY=${DISPLAY:-unset}"

PROJECT_DIR="${STORMOS_DESKTOP_DIR:-/usr/share/stormos-shell}"

export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-XFCE}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-stormos}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}"

# Disable screen blanking
xset s off -dpms 2>/dev/null || true
xset s noblank 2>/dev/null || true

# --- Compositor: picom (optional, only if not already running) ---
if command -v picom >/dev/null 2>&1; then
    if ! pgrep -x picom >/dev/null 2>&1; then
        log "Starting picom..."
        picom --daemon 2>>"$LOG" &
        log "picom PID=$!"
        sleep 0.3
    fi
fi

log "Starting XFCE session via startxfce4..."
exec startxfce4
