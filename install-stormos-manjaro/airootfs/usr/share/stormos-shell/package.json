{
  "name": "stormos-react-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite --port 5173\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "electron:start": "vite build && electron .",
    "electron:kiosk": "vite build && electron . --kiosk",
    "start": "vite build && electron .",
    "smoke": "npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "^8.0.0"
  }
}
