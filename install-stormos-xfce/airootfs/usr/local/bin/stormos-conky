#!/bin/bash
# StormOS conky launcher — resolves $HOME reliably and handles errors
CONF="$HOME/.config/conky/conky.conf"

# If config doesn't exist, create a minimal one
if [ ! -f "$CONF" ]; then
    mkdir -p "$HOME/.config/conky"
    cat > "$CONF" << 'MINIMAL'
conky.config = {
    alignment = 'top_right',
    background = true,
    double_buffer = true,
    font = 'JetBrains Mono:size=11',
    gap_x = 20,
    gap_y = 60,
    minimum_height = 400,
    minimum_width = 250,
    no_buffers = true,
    out_to_console = false,
    out_to_x = true,
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_transparent = false,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_colour = '0A1628',
    own_window_argb_visual = true,
    own_window_argb_value = 200,
    update_interval = 2.0,
    use_xft = true,
    xftalpha = 1.0,
    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    default_color = 'E8F2FF',
    color1 = '19A9FF',
};
conky.text = [[
${color1}STORMOS${font}${color}
${color1}CPU${color} ${alignr}${cpu cpu0}%
${color1}RAM${color} ${alignr}${mem} / ${memmax}
${color1}Disk${color} ${alignr}${fs_used /} / ${fs_size /}
${color1}Uptime${color} ${alignr}${uptime_short}
]];
MINIMAL
fi

# Wait for display to be ready
sleep 2

# Kill any existing conky
killall conky 2>/dev/null

# Start conky
exec conky -c "$CONF"
