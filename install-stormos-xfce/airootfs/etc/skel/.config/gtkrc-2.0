# StormOS GTK2 theme settings
# Matches StormOS-GTK dark theme with StormOS color palette

gtk-alternative-button-order = 1
gtk-theme-name = "StormOS-GTK-dark"
gtk-icon-theme-name = "StormOS-icons"
gtk-cursor-theme-name = "DMZ-Black"
gtk-cursor-theme-size = 24
gtk-font-name = "Inter 10"
gtk-toolbar-style = 3
gtk-button-images = 0
gtk-menu-images = 0
gtk-enable-animations = 1
gtk-primary-button-warps-slider = 0
