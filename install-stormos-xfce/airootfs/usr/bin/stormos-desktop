#!/usr/bin/env bash
# stormos-desktop — StormOS session: xfwm4 + panel + React shell.
#
# Base: xfwm4 (window manager) + xfce4-panel (taskbar) + xfdesktop (wallpaper/icons)
# Overlay: StormOS React shell replaces xfdesktop when available
#
# Session is always usable — React shell is optional.

set -uo pipefail

LOG="$HOME/.stormos-desktop.log"
log() { echo "[$(date '+%H:%M:%S')] $*" >> "$LOG"; }

> "$LOG"
log "=== stormos-desktop starting (pid $$) ==="
log "HOME=$HOME USER=$(whoami) DISPLAY=${DISPLAY:-unset}"

PROJECT_DIR="${STORMOS_DESKTOP_DIR:-/usr/share/stormos-shell}"

export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-XFCE}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-stormos}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}"

# Disable screen blanking
xset s off -dpms 2>/dev/null || true
xset s noblank 2>/dev/null || true

# Cleanup on exit
cleanup() {
    log "=== Cleaning up ==="
    [ -n "${ELECTRON_PID:-}" ] && kill "$ELECTRON_PID" 2>/dev/null
    [ -n "${BRIDGE_PID:-}" ] && kill "$BRIDGE_PID" 2>/dev/null
    wait 2>/dev/null
}
trap cleanup EXIT INT TERM

# --- 1. Window manager: xfwm4 ---
log "Starting xfwm4..."
xfwm4 2>>"$LOG" &
sleep 1
XFWM_PID=$(pgrep -n xfwm4 2>/dev/null || echo "")
log "xfwm4 PID=$XFWM_PID"

if [ -z "$XFWM_PID" ]; then
    log "ERROR: xfwm4 failed to start!"
    exit 1
fi

# --- 2. Panel: xfce4-panel ---
log "Starting xfce4-panel..."
xfce4-panel 2>>"$LOG" &
sleep 1
PANEL_PID=$(pgrep -n xfce4-panel 2>/dev/null || echo "")
log "xfce4-panel PID=$PANEL_PID"

# --- 3. Desktop icons/wallpaper: xfdesktop ---
log "Starting xfdesktop..."
xfdesktop --reload 2>>"$LOG" || true
XFDESKTOP_PID=$(pgrep -n xfdesktop 2>/dev/null || echo "")
log "xfdesktop PID=$XFDESKTOP_PID"

# --- 4. Compositor: picom (optional) ---
if command -v picom >/dev/null 2>&1; then
    if ! pgrep -x picom >/dev/null 2>&1; then
        log "Starting picom..."
        picom --daemon 2>>"$LOG" &
        log "picom PID=$!"
        sleep 0.3
    fi
fi

# --- 5. Bridge (background, optional) ---
BRIDGE_PID=""
if [ -f "$PROJECT_DIR/native/stormos-bridge.py" ]; then
    log "Starting bridge..."
    python3 "$PROJECT_DIR/native/stormos-bridge.py" >>"$HOME/.stormos-bridge.log" 2>&1 &
    BRIDGE_PID=$!
    log "Bridge PID=$BRIDGE_PID"
    for i in $(seq 1 15); do
        curl -sf "http://127.0.0.1:${STORMOS_BRIDGE_PORT:-47821}/api/health" >/dev/null 2>&1 && break
        sleep 0.3
    done
    log "Bridge check done"
fi

# --- 6. Electron shell (overlay, optional) ---
ELECTRON_PID=""
ELECTRON_BIN=""
for candidate in /usr/bin/electron /usr/lib/electron/electron /usr/local/bin/electron; do
    [ -x "$candidate" ] && ELECTRON_BIN="$candidate" && break
done
[ -z "$ELECTRON_BIN" ] && ELECTRON_BIN="$(command -v electron 2>/dev/null)"

if [ -n "$ELECTRON_BIN" ] && [ -d "$PROJECT_DIR/dist" ]; then
    log "Launching Electron at $ELECTRON_BIN (dir=$PROJECT_DIR)..."
    "$ELECTRON_BIN" "$PROJECT_DIR" --no-sandbox >>"$HOME/.stormos-electron.log" 2>&1 &
    ELECTRON_PID=$!
    log "Electron PID=$ELECTRON_PID"
    sleep 2
    if ! kill -0 "$ELECTRON_PID" 2>/dev/null; then
        log "WARNING: Electron died — running XFCE-only mode"
        ELECTRON_PID=""
    else
        log "Electron is running"
    fi
else
    log "No Electron available — running XFCE-only mode"
fi

# --- 7. Keep session alive ---
# Prefer waiting on Electron (overlay), fall back to panel, then xfwm4
if [ -n "$ELECTRON_PID" ]; then
    log "Waiting for Electron..."
    wait "$ELECTRON_PID" 2>/dev/null
    log "Electron exited (code=$?)"
elif [ -n "$PANEL_PID" ]; then
    log "Waiting on xfce4-panel..."
    wait "$PANEL_PID" 2>/dev/null
else
    log "Waiting on xfwm4..."
    wait "$XFWM_PID" 2>/dev/null
fi
log "=== Session ended ==="
