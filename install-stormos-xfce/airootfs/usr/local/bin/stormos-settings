#!/bin/sh
# Launch the system settings surface available in this session.
#
# The XFCE settings manager is gone with the XFCE desktop, so route to
# whatever is actually installed: nwg-look (GTK/looks) when present,
# falling back to any desktop-agnostic control center.
for candidate in nwg-look gnome-control-center lxappearance; do
    if command -v "$candidate" >/dev/null 2>&1; then
        exec "$candidate" "$@"
    fi
done

printf '%s\n' "stormos-settings: no settings application found" >&2
printf '%s\n' "Install nwg-look or gnome-control-center." >&2
exit 127
